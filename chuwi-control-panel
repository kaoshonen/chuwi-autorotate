    def toggle(self, name, action, choices, active):
        if self.updating:
            return False
        args = (choices[0] if active else choices[1],)
        self.run_action(*( (action, *args) if action else args ))
        return True  # Display the confirmed state after the command succeeds.

    def run_action(self, *args):
        if self.busy:
            return
        if args[0] == "calibrate-home":
            dialog = Gtk.MessageDialog(transient_for=self.window, modal=True, message_type=Gtk.MessageType.QUESTION,
                                       buttons=Gtk.ButtonsType.OK_CANCEL, text="Save this as your laptop position?")
            dialog.format_secondary_text("Keep the laptop in its normal position, with the display upright. This saves the current display orientation and calibrates the sensor.")
            response = dialog.run()
            dialog.destroy()
            if response != Gtk.ResponseType.OK:
                return
        self.busy = True
        for widget in self.actions:
            widget.set_sensitive(False)
        self.message.set_text("Applying…")
        future = self.pool.submit(command, *args)
        future.add_done_callback(lambda f: GLib.idle_add(self.finish_action, f, args))

    def finish_action(self, future, args):
        self.busy = False
        for widget in self.actions:
            widget.set_sensitive(True)
        try:
            result = future.result()
            output = (result.stdout + result.stderr).strip()
            if args[0] == "doctor":
                dialog = Gtk.MessageDialog(transient_for=self.window, modal=True, buttons=Gtk.ButtonsType.CLOSE,
                                           message_type=Gtk.MessageType.INFO, text="Rotation checks")
                dialog.format_secondary_text(output)
                dialog.run()
                dialog.destroy()
            if result.returncode:
                raise RuntimeError(output or "The command failed.")
            if args[0] == "sensitivity":
                self.sensitivity_dirty = False
            self.message.set_text(output.splitlines()[0] if output else "Saved.")
        except Exception as exc:
            self.notice.set_text(str(exc))
            self.notice.show()
            self.message.set_text("The change could not be completed.")
        self.refresh()
        return False

    def refresh(self):
        if (self.window and self.window.get_visible() and self.hardware_expander.get_mapped() and self.hardware_expander.get_expanded()
                and not self.hardware_pending and time.monotonic()-self.hardware_at >= 5):
            self.hardware_pending = True
            self.hardware_at = time.monotonic()
            self.pool.submit(self.hardware_snapshot).add_done_callback(lambda f: GLib.idle_add(self.apply_hardware, f))
        if self.window and self.window.get_visible() and not self.busy and not self.refreshing:
            self.refreshing = True
            self.pool.submit(snapshot).add_done_callback(lambda f: GLib.idle_add(self.apply_snapshot, f))
        return True

    def hardware_snapshot(self):
        from chuwi.display import parse_verbose
        from chuwi.hardware import capture
        from chuwi.session import read
        displays = parse_verbose(capture(["xrandr", "--verbose"]))
        selected = next((d for d in displays if d["internal"] and d["active"]), {})
        runtime = read("controller")
        runtime.update(calibration="Calibrated" if read_config().get("home_rotation") in ROTATIONS else "Needs calibration",
                       service=capture(["systemctl", "--user", "is-active", "chuwi-autorotate"]) or "Unavailable")
        return self.hardware_reader.snapshot(selected, runtime)

    def apply_hardware(self, future):
        self.hardware_pending = False
        try:
            snapshot = future.result()
            maximum = snapshot['input']['max_brightness']['value']
            self.hardware_updating = True
            writable = snapshot['input']['writable']['value'] is True
            self.backlight_apply.set_sensitive(maximum is not None and writable)
            self.backlight_level.set_sensitive(maximum is not None and writable)
            if maximum is not None:
                self.backlight_level.set_range(0, maximum)
                if not self.backlight_level.has_focus():
                    self.backlight_level.set_value(snapshot['input']['backlight']['value'] or 0)
            timer = snapshot['input']['auto_off_timer']['value']
            self.backlight_timer.set_sensitive(timer in ('0','1') and writable)
            self.backlight_timer.set_active(timer == '1')
            self.hardware_updating = False
            for (group, field), widget in self.hardware_values.items():
                reading = snapshot[group][field]
                text = reading["value"]
                if isinstance(text, float):
                    text = f"{text:.1f}"
                if isinstance(text, list):
                    text = ", ".join(text)
                widget.set_text(f"{text} {reading['unit']}".strip() if text is not None else reading["detail"] or "Unavailable")
                if group == 'thermals' and field == 'fan' and reading['value'] == 0:
                    widget.set_text('Zero reported — stopped or unreadable')
                widget.set_tooltip_text(reading["detail"] or reading["source"])
        except Exception as exc:
            for widget in self.hardware_values.values():
                widget.set_text("Unavailable")
                widget.set_tooltip_text(str(exc))
        return False

    def apply_snapshot(self, future):
        self.refreshing = False
        try:
            status, config, state = future.result()
            self.updating = True
            rotation = status.get("current xrandr rotation", "unknown")
            running = status.get("systemd user service") == "active"
            locked = config.get("rotation_locked") == "true"
            self.rotation_title.set_text(ROTATIONS.get(rotation, "Display unavailable"))
            sensor = state.get("last_sensor_orientation", "unknown")
            self.rotation_detail.set_text(f"{status.get('detected display output', 'Unknown display')} · {state.get('posture', 'unknown')} · Sensor: {sensor}")
            self.badge.set_text("Rotation locked" if locked else "Turn further to rotate" if running and state.get("angle_gate") == "Turn further" else "Following sensor" if running and sensor != "unknown" else "Waiting for sensor" if running else "Auto rotation off")
            self.preview.rotation = rotation
            self.preview.queue_draw()
            self.toggles["auto"].set_active(config.get("enabled") == "true" and running)
            self.toggles["lock"].set_active(locked)
            self.toggles["startup"].set_active(status.get("start at sign-in") == "enabled")
            for target, button in self.rotation_buttons.items():
                button.set_active(rotation == target)
            if not self.sensitivity_dirty:
                self.delay.set_value(float(config.get("debounce_seconds", "1")))
                self.threshold.set_value(float(config.get("rotation_threshold_degrees", "45")))
            batteries = list(Path("/sys/class/power_supply").glob("BAT*"))
            battery = f"{read_text(batteries[0]/'capacity')}% · {read_text(batteries[0]/'status')}" if batteries else "No battery reported"
            processor = next((line.split(":", 1)[1].strip() for line in read_text('/proc/cpuinfo', '').splitlines() if line.startswith('model name')), "Unavailable")
            values = {"Computer": read_text('/sys/class/dmi/id/product_name'), "Desktop": os.environ.get('XDG_CURRENT_DESKTOP', 'Unknown') + " · " + os.environ.get('XDG_SESSION_TYPE', 'Unknown'), "Kernel": platform.release(), "Processor": processor, "Battery": battery, "Display": status.get('detected display output', ''), "Touchscreen": status.get('detected touchscreen devices', ''), "Sensor": sensor + " · " + status.get('iio-sensor-proxy status', ''), "Agent": status.get('systemd user service', '')}
            for key, value in values.items():
                self.values[key].set_text(value)
            error = status.get("last error", "") or state.get("angle_sensor_error", "")
            if error:
                self.notice.set_text(error)
                self.notice.show()
            elif running:
                self.notice.hide()
            if self.message.get_text() == "Connecting to rotation service…":
                self.message.set_text("Ready. Your touchscreen follows the display rotation.")
        except Exception as exc:
            self.notice.set_text(str(exc))
            self.notice.show()
        finally:
            self.updating = False
        return False

