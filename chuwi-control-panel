            self.tablet.unlock()

    def tablet_ready(self):
        self.show_floating()
        def begin_after_map():
            if self.tablet is None:
                return False
            if self.floating and self.floating.get_mapped():
                self.tablet.begin()
            else:
                self.tablet.emergency_unlock("Recovery button could not be displayed; tablet mode cancelled")
            return False
        GLib.idle_add(begin_after_map)

    def show_floating(self):
        if self.floating is None:
            self.floating = Gtk.ApplicationWindow(application=self, title="CHUWI tablet unlock")
            self.floating.set_decorated(False)
            self.floating.set_resizable(False)
