        button.set_focus_on_click(False)
        button.set_sensitive(not self.keyboard_pending)
        button.set_tooltip_text("Show or hide Cinnamon’s on-screen keyboard. In tablet mode this control also stays beside Unlock.")
        button.connect("clicked",lambda _: self.toggle_screen_keyboard())
        self.keyboard_buttons.append(button)
        # Independent of rotation jobs and tablet recovery, which must stay responsive.
        return button

    def toggle_screen_keyboard(self):
        if self.keyboard_pending or self.closing:
            return
        self.keyboard_pending=True
        for button in self.keyboard_buttons:
            button.set_sensitive(False)
        Gio.bus_get(Gio.BusType.SESSION,None,self.keyboard_bus_ready,None)

    def keyboard_bus_ready(self,_source,result,_data):
        if self.closing:
            return
        try:
            connection=Gio.bus_get_finish(result)
            if identify()["desktop"] == "xfce":
                from chuwi.osk import toggle_onboard
                toggle_onboard(connection)
                self.keyboard_finished()
                return
            connection.call("org.Cinnamon","/org/Cinnamon","org.Cinnamon","ToggleKeyboard",None,None,
                            Gio.DBusCallFlags.NO_AUTO_START,1500,None,self.keyboard_done,None)
        except Exception as exc:
            self.keyboard_finished(str(exc))

    def keyboard_done(self,connection,result,_data):
        try:
            connection.call_finish(result)
            self.keyboard_finished()
        except Exception as exc:
            self.keyboard_finished(str(exc))

    def keyboard_finished(self,error=None):
        self.keyboard_pending=False
        if self.closing:
            return
        self.keyboard_error=("Screen keyboard unavailable. Open Cinnamon’s Accessibility settings to check it."
                             if error else None)
        for button in self.keyboard_buttons:
            button.set_sensitive(True)
            button.set_tooltip_text(self.keyboard_error or "Tap to show or hide the screen keyboard.")
        self.keyboard_hint.set_text(self.keyboard_error or "Tap to show or hide the screen keyboard.")
        if self.floating:
            self.floating_keyboard_notice.set_text(self.keyboard_error or "")
            self.floating_keyboard_notice.set_visible(bool(self.keyboard_error))
        self.position_floating()

    def enable_tablet(self):
        if self.window is None:
            self.do_activate()
        if self.tablet:
            self.tablet.start()

    def unlock_tablet(self):
