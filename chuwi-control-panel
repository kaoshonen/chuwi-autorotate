    def backlight_timer_changed(self, button):
        if not getattr(self, 'hardware_updating', False):
            self.ec_control('SetBacklightTimer', '(b)', (button.get_active(),))

    def ec_control(self, method, signature, values):
        def work():
            from chuwi.ec import Client
            return Client().call(method, signature, values, timeout=60000)
        def completed(future):
            try:
                future.result()
                self.message.set_text('Keyboard backlight updated.')
            except Exception as exc:
                self.notice.set_text(str(exc)); self.notice.show()
            self.hardware_at = 0
            return False
        self.pool.submit(work).add_done_callback(lambda future: GLib.idle_add(completed, future))

