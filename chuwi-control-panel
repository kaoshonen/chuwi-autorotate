            command("configure", "tablet_automatic", "false")
            self.unlock_tablet()

    def automatic_tick(self):
        if self.closing:
            return False
        from chuwi.session import read, inhibited
        enabled = read_config().get("tablet_automatic") == "true"
        state = read("controller")
        capable = bool(state.get('sensor_valid') and state.get('sensor_provider') == 'extended' and state.get('input_owner') == 'application')
        self.automatic_check.set_sensitive(capable or enabled)
        self.automatic_check.set_tooltip_text('A touchscreen recovery trial is required before automatic switching' if capable else 'Requires fresh hinge data from the application-managed sensor extension')
        requested = bool(enabled and state.get("automatic_input_request") and not inhibited())
        if requested and not self.automatic_last and self.tablet and self.tablet_state.get("phase") == "off":
            self.tablet.start(automatic=True)
        if not requested and self.tablet and getattr(self.tablet, "automatic", False):
            self.tablet.release()
        self.automatic_last = requested
        if self.recovery_only and not enabled and self.tablet_state.get("phase") == "off" and not self.automatic_pending:
            self.quit()
            return False
        return True

