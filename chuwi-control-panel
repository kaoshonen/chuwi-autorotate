            # A tap here must leave the app's text field focused for on-screen typing.
            self.floating.set_accept_focus(False)
            self.floating.connect("delete-event", lambda *_: (self.unlock_tablet(), True)[1])
            content = box(style="card", spacing=10)
            self.floating.add(content)
