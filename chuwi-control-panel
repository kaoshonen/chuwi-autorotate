def label(text="", style=None, wrap=False):
    result = Gtk.Label(label=text, xalign=0)
    if style:
        result.get_style_context().add_class(style)
    result.set_line_wrap(wrap)
    result.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    return result


def box(vertical=True, spacing=10, style=None):
    widget = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL, spacing=spacing)
    if style:
        widget.get_style_context().add_class(style)
    return widget


def read_text(path, default="Unavailable"):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def read_config():
    return dict(line.split("=", 1) for line in read_text(CONFIG, "").splitlines() if "=" in line and not line.startswith("#"))


def command(*args):
    return subprocess.run([str(ENGINE), *args], capture_output=True, text=True, timeout=35,
                          env={**os.environ, "LC_ALL": "C"})


def snapshot():
    result = command("status")
    if result.returncode:
        raise RuntimeError(result.stderr or result.stdout)
    status = dict(line.split(": ", 1) for line in result.stdout.splitlines() if ": " in line)
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    return status, read_config(), state


class ScreenPreview(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.rotation = "right"
        self.set_size_request(170, 115)
        self.connect("draw", self.draw_screen)

    def draw_screen(self, widget, cr):
        width, height = self.get_allocated_width(), self.get_allocated_height()
        w, h = (146, 88) if self.rotation in ("right", "left") else (78, 108)
        x, y = (width-w)/2, (height-h)/2
        cr.set_source_rgb(.16, .22, .36)
        cr.rectangle(x, y, w, h)
        cr.fill()
        cr.set_source_rgb(.34, .43, .70)
        cr.rectangle(x+5, y+5, w-10, h-10)
        cr.fill()
        cr.set_source_rgb(.85, .91, 1)
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(14)
        text = "CHUWI"
        extents = cr.text_extents(text)
        cr.move_to(width/2-extents.width/2, height/2+5)
        cr.show_text(text)
        cr.set_source_rgb(.37, .84, .69)
        cr.arc(width/2, y+h-10, 2, 0, 6.283)
        cr.fill()
        return False


class TabletArtwork(Gtk.DrawingArea):
    """Scalable folding illustrations; animation is cosmetic and never touches input."""
    def __init__(self):
        super().__init__()
        self.set_size_request(164, 126)
        self.frame = 0
        self.active = False
        self.timer = None
        self.connect("draw", self.draw_artwork)
        self.connect("unmap", lambda *_: self.stop())
        self.connect("destroy", lambda *_: self.stop())

    def start(self, *_args):
        if not self.active and self.timer is None and Gtk.Settings.get_default().get_property("gtk-enable-animations"):
            self.timer = GLib.timeout_add(750, self.advance)
        return False

    def stop(self, *_args):
        if self.timer is not None:
            GLib.source_remove(self.timer)
            self.timer = None
        self.frame = 2 if self.active else 0
        self.queue_draw()
        return False

    def advance(self):
        self.frame = (self.frame + 1) % 3
        self.queue_draw()
        return True

    def set_active(self, active):
        if self.active != active:
            self.active = active
            self.stop()

    def draw_artwork(self, _widget, cr):
        cr.save()
        cr.translate(self.get_allocated_width()/2-82, self.get_allocated_height()/2-63)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)

        def polygon(points, fill, stroke=None, line_width=2):
            cr.move_to(*points[0])
            for point in points[1:]:cr.line_to(*point)
            cr.close_path()
            cr.set_source_rgba(*fill)
            cr.fill_preserve()
            if stroke:
                cr.set_source_rgba(*stroke);cr.set_line_width(line_width);cr.stroke()
            else:cr.new_path()

        def screen(outer, inner):
            polygon(outer, (.10,.17,.35,1), (.90,.95,1,.95), 2.2)
            cr.save()
            cr.move_to(*inner[0])
            for point in inner[1:]:cr.line_to(*point)
            cr.close_path();cr.clip()
            gradient=cairo.LinearGradient(25,20,140,105)
            gradient.add_color_stop_rgb(0,.43,.70,1)
            gradient.add_color_stop_rgb(1,.20,.38,.80)
            cr.set_source(gradient);cr.paint()
            cr.set_source_rgba(.42,1,.91,.90)
            cr.move_to(14,105);cr.curve_to(50,43,94,109,155,42)
            cr.line_to(165,126);cr.line_to(14,126);cr.close_path();cr.fill()
            cr.set_source_rgba(.88,.98,1,.38)
            cr.move_to(20,38);cr.curve_to(66,62,89,4,152,32)
            cr.set_line_width(12);cr.stroke()
            cr.restore()

        # A soft pool anchors the device without adding another icon or label.
        cr.save();cr.translate(82,103);cr.scale(60,7)
        cr.set_source_rgba(.10,.16,.35,.20);cr.arc(0,0,1,0,math.tau);cr.fill();cr.restore()
        if self.frame == 0:
            screen([(25,23),(123,13),(129,74),(31,83)],[(31,29),(117,20),(122,68),(37,76)])
            polygon([(31,83),(129,74),(148,98),(14,108)],(.79,.86,1,1),(.94,.97,1,1))
            cr.set_source_rgba(.27,.37,.64,.65);cr.set_line_width(1.5)
            for y in (84,89,94):
                cr.move_to(42,y);cr.line_to(119,y-7);cr.stroke()
            polygon([(65,98),(89,96),(94,101),(63,104)],(.42,.54,.79,.7))
            # Fold-back arrow, drawn as part of the illustration.
            cr.set_source_rgba(.79,1,.96,.95);cr.set_line_width(2.5)
            cr.move_to(15,58);cr.curve_to(2,35,9,12,27,8);cr.stroke()
            cr.move_to(21,4);cr.line_to(28,8);cr.line_to(22,14);cr.stroke()
        elif self.frame == 1:
            polygon([(67,17),(15,91),(43,87),(78,28)],(.72,.81,1,.85),(.94,.97,1,.95))
            screen([(67,17),(143,33),(118,105),(40,88)],[(70,25),(134,39),(112,97),(48,83)])
            cr.set_source_rgba(.79,1,.96,.95);cr.set_line_width(2.5)
            cr.move_to(24,47);cr.curve_to(17,30,25,12,43,10);cr.stroke()
            cr.move_to(37,6);cr.line_to(44,10);cr.line_to(38,16);cr.stroke()
        else:
            screen([(26,28),(132,14),(144,91),(38,106)],[(33,34),(126,21),(136,85),(44,98)])
            cr.set_source_rgba(.90,.95,1,.9);cr.arc(80,24,1.5,0,math.tau);cr.fill()
            if self.active:
                cr.set_source_rgb(.79,1,.93);cr.arc(134,91,15,0,math.tau);cr.fill()
                cr.set_source_rgb(.09,.36,.41);cr.set_line_width(2.2)
                cr.arc(134,88,4,math.pi,math.tau);cr.stroke()
                cr.rectangle(128,88,12,9);cr.fill()
        for index in range(3):
            cr.set_source_rgba(1,1,1,.95 if self.frame == index else .30)
            cr.arc(70+index*12,120,2.3,0,math.tau);cr.fill()
        cr.restore()
        return False


class ControlArtwork(Gtk.DrawingArea):
    """Static vector pictures shared by action buttons and navigation."""
    def __init__(self, kind, width=100, height=82):
        super().__init__()
        self.kind = kind
        self.set_size_request(width, height)
        self.set_halign(Gtk.Align.CENTER)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("draw", self.draw_picture)

    def draw_picture(self, _widget, cr):
        width, height = self.get_allocated_width(), self.get_allocated_height()
        scale = min(width/120, height/100)
        cr.save();cr.translate((width-120*scale)/2,(height-100*scale)/2);cr.scale(scale,scale)
        cr.set_line_join(cairo.LINE_JOIN_ROUND);cr.set_line_cap(cairo.LINE_CAP_ROUND)

        def path(points, color, stroke=None, thickness=2.5):
            cr.move_to(*points[0])
            for point in points[1:]:cr.line_to(*point)
            cr.close_path();cr.set_source_rgba(*color);cr.fill_preserve()
            if stroke:
                cr.set_source_rgba(*stroke);cr.set_line_width(thickness);cr.stroke()
            else:cr.new_path()

        def rounded(x,y,w,h,r,color,stroke=None):
            cr.new_sub_path();cr.arc(x+w-r,y+r,r,-math.pi/2,0)
            cr.arc(x+w-r,y+h-r,r,0,math.pi/2);cr.arc(x+r,y+h-r,r,math.pi/2,math.pi)
            cr.arc(x+r,y+r,r,math.pi,math.pi*1.5);cr.close_path()
            cr.set_source_rgba(*color);cr.fill_preserve()
            if stroke:
                cr.set_source_rgba(*stroke);cr.set_line_width(2.5);cr.stroke()
            else:cr.new_path()

        navy=(.14,.23,.41,1);edge=(.85,.91,1,1);cyan=(.34,.91,.82,1)
        blue=(.36,.51,.90,1);pale=(.91,.95,1,1);white=(1,1,1,1)
        def line(points,color=navy,thickness=3):
            cr.set_source_rgba(*color);cr.set_line_width(thickness);cr.move_to(*points[0])
            for point in points[1:]:cr.line_to(*point)
            cr.stroke()

        def circle(x,y,r,color):
            cr.set_source_rgba(*color);cr.arc(x,y,r,0,math.tau);cr.fill()

        def device(w=98,h=65,flip=False):
            cr.save();cr.translate(60,48)
            if flip:cr.rotate(math.pi)
            rounded(-w/2,-h/2,w,h,6,navy,edge)
            cr.rectangle(-w/2+6,-h/2+7,w-12,h-14)
            gradient=cairo.LinearGradient(-w/2,-h/2,w/2,h/2)
            gradient.add_color_stop_rgb(0,.48,.72,1);gradient.add_color_stop_rgb(1,.27,.43,.84)
            cr.set_source(gradient);cr.fill()
            cr.save();cr.rectangle(-w/2+6,-h/2+7,w-12,h-14);cr.clip()
            cr.set_source_rgba(*cyan);cr.move_to(-w/2,h/2)
            cr.curve_to(-w/4,-h/4,w/8,h/2,w/2,-h/10)
            cr.line_to(w/2,h/2);cr.close_path();cr.fill()
            line([(-w/2,-h/5),(w/2,-h/3)],(.87,.96,1,.35),9)
            cr.restore();circle(0,-h/2+3,1.2,pale);cr.restore()

        def check(x=83,y=75):
            circle(x,y,15,cyan)
            line([(x-7,y),(x-2,y+5),(x+8,y-6)],navy,3.2)

        kind=self.kind
        if kind == "trackpad":
            rounded(15,15,90,70,8,pale,navy)
            line([(20,62),(100,62)],blue,2)
            line([(60,62),(60,80)],blue,2)
            circle(60,35,9,cyan)
        elif kind in ROTATIONS:
            device(98,65,kind=="left") if kind in ("right","left") else device(57,84,kind=="inverted")
        elif kind in ("home","calibrate","display","rotate","lock","startup"):
            device(92,59)
            if kind=="home":
                path([(14,78),(106,78),(116,91),(4,91)],edge,white)
                rounded(49,82,22,5,2,blue)
                path([(89,21),(105,8),(120,21)],cyan)
                rounded(93,20,22,16,2,cyan);rounded(102,25,6,11,1,navy)
            elif kind=="calibrate":
                circle(60,48,19,(1,1,1,.85));circle(60,48,12,(.84,.40,.62,1));circle(60,48,5,white)
                line([(60,21),(60,35)],navy,2);line([(60,61),(60,75)],navy,2)
                line([(33,48),(47,48)],navy,2);line([(73,48),(87,48)],navy,2)
            elif kind=="display":
                path([(51,79),(69,79),(73,89),(47,89)],navy)
                rounded(38,87,44,5,2,navy)
                circle(101,20,12,(1,.77,.30,1))
            elif kind=="startup":
                circle(93,75,17,cyan);line([(93,86),(93,65)],navy,3)
                line([(85,73),(93,65),(101,73)],navy,3)
            elif kind=="lock":
                rounded(82,65,27,23,4,cyan)
                cr.set_source_rgba(*navy);cr.set_line_width(4);cr.arc(95,64,8,math.pi,math.tau);cr.stroke()
            else:
                cr.set_source_rgba(*navy);cr.set_line_width(4);cr.arc(60,48,43,.15,2.9);cr.stroke()
                path([(15,48),(15,64),(29,57)],cyan)
        elif kind=="power":
            rounded(19,27,80,47,9,navy,edge);rounded(99,40,8,20,3,navy)
            rounded(26,34,51,33,4,cyan)
            path([(64,15),(44,52),(59,52),(51,84),(82,43),(66,43)],(1,.76,.32,1),pale,1.5)
        elif kind=="keyboard":
            rounded(8,22,104,64,10,navy,edge)
            rounded(14,28,92,52,6,blue)
            for row in range(3):
                for column in range(8):
                    rounded(20+column*10.5,35+row*10,7,6,1.5,pale)
            rounded(39,66,43,7,2,cyan)
            circle(101,18,14,cyan)
            line([(95,18),(107,18)],navy,2.5)
            line([(101,12),(101,24)],navy,2.5)
        elif kind in ("doctor","health"):
            rounded(28,12,64,79,8,navy,edge);rounded(35,20,50,62,4,pale)
            rounded(47,8,27,12,4,blue)
            line([(41,49),(48,49),(54,36),(62,65),(69,45),(78,45)],blue,3)
            check(87,77)
        elif kind=="save":
            path([(25,12),(83,12),(97,26),(97,88),(25,88)],blue,edge)
            rounded(37,13,43,25,2,pale);rounded(65,15,9,20,1,navy)
            rounded(37,53,46,29,3,navy);check(93,78)
        elif kind in ("unlock","confirm"):
            if kind=="unlock":
                rounded(29,43,64,46,9,blue,edge)
                cr.set_source_rgba(*navy);cr.set_line_width(8)
                cr.arc(61,38,20,math.pi,math.tau-.55);cr.stroke()
                circle(61,62,5,pale);line([(61,62),(61,74)],pale,4)
                check(94,80)
            else:
                circle(58,34,25,(.37,.74,.94,.22));circle(58,34,17,(.37,.74,.94,.30))
                rounded(50,26,14,43,7,pale,blue)
                path([(40,56),(51,65),(51,49),(84,57),(89,73),(78,92),(51,92),(30,68)],pale,blue)
                line([(65,57),(65,69)],blue,2);line([(75,60),(75,71)],blue,2)
        elif kind=="projects":
            path([(14,27),(48,27),(56,36),(106,36),(106,86),(14,86)],navy,edge)
            rounded(19,42,82,44,5,blue)
            line([(43,58),(43,74),(76,74),(76,58)],cyan,3)
            for x,y in ((43,58),(76,58),(43,74)):circle(x,y,5,pale)
        elif kind=="refresh":
            circle(60,50,35,(.83,.90,1,1))
            cr.set_source_rgba(*blue);cr.set_line_width(8);cr.arc(60,50,27,.6,5.9);cr.stroke()
            path([(91,30),(93,52),(74,44)],navy)
        elif kind=="info":
            circle(60,50,35,blue);circle(60,32,5,white)
            line([(60,47),(60,69)],white,8)
        cr.restore()
        return False


def picture_button(widget, caption, kind, *, tile=False, accessible=None, size=None):
    """Decorate the existing widget, preserving its signal handlers and semantics."""
    previous=widget.get_child()
    if previous is not None:widget.remove(previous)
    content=box(tile,8 if tile else 9)
    content.set_halign(Gtk.Align.CENTER);content.set_valign(Gtk.Align.CENTER)
    width,height=size or ((100,82) if tile else (32,28))
    content.pack_start(ControlArtwork(kind,width,height),False,False,0)
    if caption:
        title=label(caption,"picture-title" if tile else None,True)
        title.set_xalign(.5 if tile else 0)
        if tile:title.set_max_width_chars(16)
        content.pack_start(title,False,False,0)
    widget.add(content)
    widget.get_style_context().add_class("picture-tile" if tile else "picture-button")
    widget.get_accessible().set_name(accessible or caption)
    widget.set_tooltip_text(accessible or caption)
    if tile:widget.set_size_request(108,140)
    return widget


