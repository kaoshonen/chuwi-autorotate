            content.pack_start(self.floating_keyboard,False,False,0)
            self.floating_keyboard_notice=label("","notice",True)
            self.floating_keyboard_notice.set_max_width_chars(30)
            self.floating_keyboard_notice.set_no_show_all(True)
            content.pack_start(self.floating_keyboard_notice,False,False,0)
            self.floating.connect("size-allocate", lambda *_: self.position_floating())
            screen = self.floating.get_screen()
            screen.connect("monitors-changed", lambda *_: self.position_floating())
            screen.connect("size-changed", lambda *_: self.position_floating())
        self.floating.show_all()
        self.floating_keyboard_notice.set_text(self.keyboard_error or "")
        self.floating_keyboard_notice.set_visible(bool(self.keyboard_error))
        self.position_floating()

    def position_floating(self):
        if not self.floating or not self.floating.get_visible():
            return
        screen = self.floating.get_screen()
        output = read_config().get("display", "auto")
        monitor = next((index for index in range(screen.get_n_monitors())
                        if screen.get_monitor_plug_name(index) == output), screen.get_primary_monitor())
        if monitor < 0:
            monitor = 0
        area = screen.get_monitor_workarea(monitor)
        width, height = self.floating.get_size()
        # Keep recovery on the opposite edge from Cinnamon's keyboard, even before it opens.
        keyboard_at_top = self.keyboard_settings and self.keyboard_settings.get_string("keyboard-position") == "top"
        self.floating.move(*floating_position((area.x, area.y, area.width, area.height), (width, height),
                                              bottom=bool(keyboard_at_top)))

    def confirm_tablet_touch(self, gesture, _count, x, y):
        width, height = self.touch_confirm.get_allocated_width(), self.touch_confirm.get_allocated_height()
        sequence = gesture.get_current_sequence()
        # NULL is GTK's valid sequence for touchscreen-emulated pointer events.
        event = gesture.get_last_event(sequence)
        device = event.get_source_device() if event else None
        touch_release = event is not None and (
            (event.type == Gdk.EventType.TOUCH_END and sequence is not None)
            or (event.type == Gdk.EventType.BUTTON_RELEASE and sequence is None and event.get_button() == (True, 1)))
        actual_touch = (touch_release and not event.send_event
                        and device is not None and device.get_source() == Gdk.InputSource.TOUCHSCREEN)
        if actual_touch and gesture.get_touch_only() and 0 <= x < width and 0 <= y < height and self.tablet_state.get("phase") == "trial":
            self.tablet.confirm_touch()

    def tablet_changed(self, state):
        self.tablet_state = state
        if hasattr(self, "trackpad_page"):
            self.trackpad_page.set_locked(state.get("phase", "off") != "off")
        if state.get("phase") == "locked" and self.automatic_pending:
            command("configure", "tablet_automatic", "true")
            self.automatic_pending = False
            if self.tablet:
                self.tablet.automatic = True
                self.tablet.release()
        phase = state.get("phase", "off")
        active = phase != "off"
        reason = state.get("reason", "")
        heading, description = {
            "off": ("Laptop mode", "Keyboard & touchpad available."),
            "arming": ("Getting ready…", "Checking automatic recovery."),
            "trial": ("Touch test", "Confirm on the floating button."),
            "locked": ("Tablet mode on", "Keyboard & touchpad locked."),
            "recovering": ("Restoring input…", "Keyboard & touchpad will return."),
            "error": ("Recovery needs attention", reason),
        }.get(phase, ("Tablet mode", reason))
        self.tablet_heading.set_text(heading)
        self.tablet_description.set_text(description)
        self.tablet_description.set_tooltip_text(reason)
        self.tablet_hint.set_text("First use: 10-second touch test." if phase in ("off","trial") else "Screen keyboard stays beside Unlock." if phase == "locked" else "")
        self.tablet_tile_title.set_text("Unlock inputs" if active else "Tablet mode")
        self.tablet_button.get_accessible().set_name("Unlock keyboard and touchpad" if active else "Enable tablet mode")
        style=self.tablet_button.get_style_context()
        style.add_class("tablet-on") if phase in ("trial","locked") else style.remove_class("tablet-on")
        self.tablet_artwork.set_active(phase in ("trial","locked"))
        self.tablet_button.set_sensitive(phase != "arming")
        self.header_unlock.set_visible(active)
        if phase in ("trial", "locked", "recovering", "error"):
            self.show_floating()
            self.floating_status.set_text(f"Test: unlocks in {state.get('remaining', 0)} seconds" if phase == "trial" else
                                          "Tablet mode on" if phase == "locked" else "Restoring input…" if phase == "recovering" else "Input recovery needs attention")
            self.touch_confirm.set_visible(phase == "trial")
            self.position_floating()
        elif self.floating:
            self.floating.hide()

    def close_panel(self, *_args):
        if hasattr(self, "trackpad_page") and self.trackpad_page.measuring:
            self.trackpad_page.cancel()
        if read_config().get("tablet_automatic") == "true":
            self.recovery_only = True
            if not self.held:
                self.hold()
                self.held = True
            self.window.hide()
            return True
        self.closing = True
        if self.tablet:
            self.tablet.close()
            self.tablet = None
        self.quit()
        return True

