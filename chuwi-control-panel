            self.touch_confirm.set_size_request(280, 60)
            self.touch_confirm.set_can_focus(False)
            self.touch_gesture = Gtk.GestureMultiPress.new(self.touch_confirm)
            self.touch_gesture.set_touch_only(True)
            # Observe native touch before GtkButton translates it into pointer events.
            self.touch_gesture.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            self.touch_gesture.connect("released", self.confirm_tablet_touch)
            # No clicked handler: mouse clicks, keyboard activation and synthetic clicks cannot confirm.
            content.pack_start(self.touch_confirm, False, False, 0)
            self.floating_unlock = picture_button(Gtk.Button(),"Unlock keyboard & touchpad","unlock",size=(38,36))
            self.floating_unlock.set_size_request(280, 68)
            self.floating_unlock.set_focus_on_click(False)
