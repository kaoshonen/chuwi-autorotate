@@ -10,6 +10,9 @@
  */
 
 #include <linux/acpi.h>
+#include <linux/dmi.h>
+#include <linux/string.h>
+#include <asm/processor.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
@@ -96,10 +99,29 @@
 
 static struct platform_device *minibook_ec_pdev;
 
+static const struct dmi_system_id minibook_ec_models[] = {
+        {
+                .ident = "CHUWI MiniBook X DNN20",
+                .matches = {
+                        DMI_EXACT_MATCH(DMI_SYS_VENDOR, "CHUWI Innovation And Technology(ShenZhen)co.,Ltd"),
+                        DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "MiniBook X"),
+                        DMI_MATCH(DMI_BIOS_VERSION, "DNN20"),
+                },
+        },
+        { }
+};
+
+static bool hardware_validated;
+module_param(hardware_validated, bool, 0400);
+MODULE_PARM_DESC(hardware_validated, "Explicit acknowledgement of individual hardware validation");
+
 static int __init minibook_ec_init(void)
 {
 	int ret;
 
+	if (!hardware_validated || !dmi_check_system(minibook_ec_models) ||
+            !strstr(boot_cpu_data.x86_model_id, "N150"))
+		return -ENODEV;
 	ret = platform_driver_register(&minibook_ec_driver);
 	if (ret)
 		return ret;
