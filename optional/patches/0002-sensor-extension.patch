@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "chuwi-extension.h"
+
+static void test_snapshot (void)
+{
+    double gravity[3] = {0.4,-0.8,0.2};
+    gint64 first, second;
+    const gchar *mode, *owner;
+    gboolean valid;
+    chuwi_application_managed = TRUE;
+    chuwi_publish(0, 100, TRUE, gravity, "normal", 90);
+    GVariant *s = chuwi_snapshot();
+    g_assert_true(g_variant_lookup(s, "sample_monotonic_us", "x", &first));
+    g_assert_true(g_variant_lookup(s, "input_owner", "&s", &owner));
+    g_assert_cmpstr(owner, ==, "application");
+    GVariant *g = g_variant_lookup_value(s, "display_gravity", G_VARIANT_TYPE("ad"));
+    gsize n; const double *v = g_variant_get_fixed_array(g, &n, sizeof(double));
+    g_assert_cmpuint(n, ==, 3); g_assert_cmpfloat(v[0], ==, gravity[0]);
+    g_variant_unref(g);g_variant_unref(s);
+    chuwi_publish(0, 101, TRUE, gravity, "normal", 90);
+    s = chuwi_snapshot();g_variant_lookup(s,"sample_monotonic_us","x",&second);
+    g_assert_cmpint(first, ==, second);g_variant_unref(s);
+    chuwi_publish(1, 230, TRUE, gravity, "normal", 90);
+    s = chuwi_snapshot();g_variant_lookup(s,"mode","&s",&mode);
+    g_assert_cmpstr(mode, ==, "tablet");g_variant_unref(s);
+    chuwi_publish(1, 230, FALSE, gravity, "normal", 90);
+    s = chuwi_snapshot();g_variant_lookup(s,"mode","&s",&mode);
+    g_assert_cmpstr(mode, ==, "unknown");g_variant_unref(s);
+    chuwi_invalidate();s=chuwi_snapshot();g_variant_lookup(s,"valid","b",&valid);
+    g_assert_false(valid);g_variant_unref(s);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc,&argv,NULL);
+    g_test_add_func("/chuwi/snapshot-throttling-mode-gravity-invalidation",test_snapshot);
+    return g_test_run();
+}
