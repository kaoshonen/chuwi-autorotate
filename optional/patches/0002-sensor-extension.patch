--- a/iio-sensor-proxy/src/chuwi-extension.c
+++ b/iio-sensor-proxy/src/chuwi-extension.c
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "chuwi-extension.h"
+#include <math.h>
+#include <string.h>
+
+#define INTERFACE "io.github.kaoshonen.ChuwiSensor1"
+#define PATH "/net/hadess/SensorProxy"
+
+gboolean chuwi_application_managed = FALSE;
+static GDBusConnection *bus;
+static GVariant *snapshot;
+static gint64 published;
+static gint previous_mode = -2;
+static gboolean previous_valid;
+static double previous_gravity[3];
+static char *previous_orientation;
+
+GVariant *
+chuwi_snapshot (void)
+{
+        if (!snapshot) {
+                GVariantBuilder b;
+                g_variant_builder_init (&b, G_VARIANT_TYPE_VARDICT);
+                g_variant_builder_add (&b, "{sv}", "version", g_variant_new_uint32 (1));
+                g_variant_builder_add (&b, "{sv}", "valid", g_variant_new_boolean (FALSE));
+                snapshot = g_variant_ref_sink (g_variant_builder_end (&b));
+        }
+        return g_variant_ref (snapshot);
+}
+
+static void
+changed (void)
+{
+        GVariantBuilder b;
+        if (!bus)
+                return;
+        g_variant_builder_init (&b, G_VARIANT_TYPE_VARDICT);
+        g_variant_builder_add (&b, "{sv}", "Snapshot", snapshot);
+        g_dbus_connection_emit_signal (bus, NULL, PATH, "org.freedesktop.DBus.Properties",
+                "PropertiesChanged", g_variant_new ("(sa{sv}as)", INTERFACE, &b, NULL), NULL);
+}
+
+void
+chuwi_invalidate (void)
+{
+        if (!previous_valid)
+                return;
+        previous_valid = FALSE;
+        previous_mode = -2;
+        g_clear_pointer (&snapshot, g_variant_unref);
+        g_variant_unref (chuwi_snapshot ());
+        changed ();
+}
+
+void
+chuwi_publish (gint mode, double hinge, gboolean hinge_valid,
+               const double gravity[3], const char *orientation, gint panel_deg)
+{
+        GVariantBuilder b;
+        gint64 now = g_get_monotonic_time ();
+        gboolean moving = g_strcmp0 (orientation, previous_orientation) != 0;
+        gboolean valid = TRUE;
+        const char *posture = "unknown";
+        const char *owner = "upstream";
+        for (gint i = 0; i < 3; i++) {
+                moving |= fabs (gravity[i] - previous_gravity[i]) > 0.01;
+                valid &= isfinite (gravity[i]);
+        }
+        hinge_valid &= isfinite (hinge) && hinge >= 0 && hinge <= 360.5;
+        if (!hinge_valid)
+                mode = -1;
+        if (mode == previous_mode && valid == previous_valid &&
+            now - published < (moving ? 200000 : 1000000))
+                return;
+        if (mode == 0)
+                posture = "laptop";
+        else if (mode == 1)
+                posture = "tablet";
+        if (chuwi_application_managed)
+                owner = "application";
+        g_variant_builder_init (&b, G_VARIANT_TYPE_VARDICT);
+        g_variant_builder_add (&b, "{sv}", "version", g_variant_new_uint32 (1));
+        g_variant_builder_add (&b, "{sv}", "valid", g_variant_new_boolean (valid));
+        g_variant_builder_add (&b, "{sv}", "sample_monotonic_us", g_variant_new_int64 (now));
+        g_variant_builder_add (&b, "{sv}", "mode", g_variant_new_string (posture));
+        g_variant_builder_add (&b, "{sv}", "hinge_valid", g_variant_new_boolean (hinge_valid));
+        g_variant_builder_add (&b, "{sv}", "hinge_degrees", g_variant_new_double (hinge));
+        g_variant_builder_add (&b, "{sv}", "display_gravity", g_variant_new_fixed_array (G_VARIANT_TYPE_DOUBLE, gravity, 3, sizeof (double)));
+        g_variant_builder_add (&b, "{sv}", "orientation", g_variant_new_string (orientation));
+        g_variant_builder_add (&b, "{sv}", "frame", g_variant_new_string ("mxc6655-display-v1"));
+        g_variant_builder_add (&b, "{sv}", "panel_compensation_degrees", g_variant_new_int32 (panel_deg));
+        g_variant_builder_add (&b, "{sv}", "input_owner", g_variant_new_string (owner));
+        g_clear_pointer (&snapshot, g_variant_unref);
+        snapshot = g_variant_ref_sink (g_variant_builder_end (&b));
+        previous_mode = mode;
+        previous_valid = valid;
+        published = now;
+        memcpy (previous_gravity, gravity, sizeof (previous_gravity));
+        g_free (previous_orientation);
+        previous_orientation = g_strdup (orientation);
+        changed ();
+}
+
+static GVariant *
+get_property (GDBusConnection *c, const gchar *s, const gchar *p,
+              const gchar *i, const gchar *property, GError **error, gpointer data)
+{
+        return chuwi_snapshot ();
+}
+
+static void
+sleep_changed (GDBusConnection *c, const gchar *s, const gchar *p,
+               const gchar *i, const gchar *n, GVariant *parameters, gpointer data)
+{
+        chuwi_invalidate ();
+}
+
+void
+chuwi_export (GDBusConnection *connection)
+{
+        static const GDBusInterfaceVTable vtable = { .get_property = get_property };
+        GDBusNodeInfo *info = g_dbus_node_info_new_for_xml (
+                "<node><interface name='" INTERFACE "'><property name='Snapshot' type='a{sv}' access='read'/></interface></node>", NULL);
+        bus = g_object_ref (connection);
+        g_dbus_connection_register_object (bus, PATH, info->interfaces[0], &vtable, NULL, NULL, NULL);
+        g_dbus_node_info_unref (info);
+        g_dbus_connection_signal_subscribe (bus, "org.freedesktop.login1", "org.freedesktop.login1.Manager",
+                "PrepareForSleep", "/org/freedesktop/login1", NULL, G_DBUS_SIGNAL_FLAGS_NONE, sleep_changed, NULL, NULL);
+}
