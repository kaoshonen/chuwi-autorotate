def doctor_line(status: str, label: str, detail: str, fix: Optional[str] = None) -> bool:
    print(f"{status}: {label} - {detail}")
    if fix:
        print(f"  fix: {fix}")
    return status == "OK"


def command_doctor(_: argparse.Namespace) -> int:
    ok = True

    if command_exists("xrandr"):
        ok &= doctor_line("OK", "xrandr", shutil.which("xrandr") or "found")
    else:
        ok &= doctor_line("MISSING", "xrandr", "not found", "sudo apt install x11-xserver-utils")

    if command_exists("xinput"):
        ok &= doctor_line("OK", "xinput", shutil.which("xinput") or "found")
    else:
        ok &= doctor_line("MISSING", "xinput", "not found", "sudo apt install xinput")

    if command_exists("monitor-sensor"):
        ok &= doctor_line("OK", "monitor-sensor", shutil.which("monitor-sensor") or "found")
    else:
        ok &= doctor_line(
            "MISSING",
            "monitor-sensor",
            "not found",
            "sudo apt install iio-sensor-proxy",
        )

    iio_status = iio_sensor_proxy_status()
    if iio_status in {"active", "activating"} or iio_status.startswith("installed"):
        ok &= doctor_line("OK", "iio-sensor-proxy service", iio_status)
    else:
        ok &= doctor_line(
            "MISSING",
            "iio-sensor-proxy service",
            iio_status,
            "sudo apt install iio-sensor-proxy",
        )

    display_env = os.environ.get("DISPLAY")
    session_type = os.environ.get("XDG_SESSION_TYPE", "unknown")
    if display_env and session_type.lower() != "wayland":
        ok &= doctor_line("OK", "active graphical session", f"DISPLAY={display_env}, session={session_type}")
    elif display_env and session_type.lower() == "wayland":
        ok &= doctor_line(
            "MISSING",
            "active graphical session",
            "Wayland session detected",
            "log into the Linux Mint Xfce X11 session",
        )
    else:
        ok &= doctor_line(
            "MISSING",
            "active graphical session",
            "DISPLAY is not set",
            "run this from your Xfce desktop session, not from a TTY or SSH shell",
        )

    if command_exists("xrandr") and display_env:
        try:
            display = detect_display(requested="auto")
            ok &= doctor_line("OK", "connected internal display", f"{display.name}, rotation {display.rotation}")
        except AutorotateError as exc:
            ok &= doctor_line("MISSING", "connected internal display", str(exc), "check xrandr --query")
    else:
        ok &= doctor_line("MISSING", "connected internal display", "not checked", "fix xrandr/DISPLAY first")

    if command_exists("xinput") and display_env:
        devices = detect_touchscreens()
        if devices:
            detail = ", ".join(f"{device['name']} (id {device['id']})" for device in devices)
            ok &= doctor_line("OK", "touchscreen device", detail)
        else:
            doctor_line(
                "WARN",
                "touchscreen device",
                "none matched touch/touchscreen/goodix/silead/wacom",
                "run xinput --list and add a matching name if needed",
            )
    else:
        doctor_line("WARN", "touchscreen device", "not checked", "fix xinput/DISPLAY first")

    print()
    print("Package install command:")
    print("  sudo apt install iio-sensor-proxy x11-xserver-utils xinput")
    return 0 if ok else 1


def monitor_reader(process: subprocess.Popen, events: "queue.Queue[Optional[str]]") -> None:
    assert process.stdout is not None
    for raw_line in process.stdout:
        events.put(raw_line.rstrip("\n"))
    events.put(None)


def parse_mount_matrix(value: str) -> Tuple[float, ...]:
    try:
        matrix = tuple(float(v.strip()) for v in re.split(r"[,;]", value))
    except ValueError:
        raise AutorotateError("invalid accelerometer mount matrix")
    if len(matrix) != 9 or not all(math.isfinite(v) for v in matrix) or any(
            not any(matrix[row*3:row*3+3]) for row in range(3)):
        raise AutorotateError("invalid accelerometer mount matrix")
    return matrix


def angle_allows_rotation(orientation: Optional[str], vector: Tuple[float, float, float], threshold: float) -> bool:
    """Require proximity to the candidate's axis, using iio-sensor-proxy conventions.

    A 65° switch threshold means within 25° of the next upright orientation.
    Opposite transitions use the same acceptance cone; flat screens hold their view.
    """
    if orientation not in SENSOR_DEGREES or not all(math.isfinite(v) for v in vector):
        return False
    x, y, z = vector
    plane = math.hypot(x, y)
    total = math.sqrt(x*x + y*y + z*z)
    if total == 0 or plane < total * 0.5:
        return False
    projection = {"normal": -y, "right-up": -x, "bottom-up": y, "left-up": x}[orientation]
    return projection / plane >= math.cos(math.radians(90-threshold)) - 1e-9


class IIOAngleSensor:
    """Read-only gravity sampling; follows the proxy's mount-matrix precedence."""
    def __init__(self, root=Path("/sys/bus/iio/devices")):
        self.root = root
        self.device = None
        self.matrix = None
        self.next_discovery = 0

    def discover(self):
        candidates = []
        for device in sorted(self.root.glob("iio:device*")):
            if not all((device / f"in_accel_{axis}_raw").exists() for axis in "xyz"):
                continue
            properties = {}
            if command_exists("udevadm"):
                result = run_capture(["udevadm", "info", "--query=property", f"--path={device}"], timeout=3)
                if result.returncode == 0:
                    properties = parse_environment_lines(result.stdout)
            if properties.get("ACCEL_LOCATION") != "base":
                candidates.append((device, properties))
        display = [c for c in candidates if c[1].get("ACCEL_LOCATION") == "display"]
        candidates = display or candidates
        if len(candidates) != 1:
            raise AutorotateError("angle control needs one identifiable display accelerometer")
        device, properties = candidates[0]
        matrix = properties.get("ACCEL_MOUNT_MATRIX")
        if matrix is None:
            for name in ("mount_matrix", "in_accel_mount_matrix", "in_mount_matrix"):
                if (device / name).exists():
                    matrix = (device / name).read_text().strip()
                    break
        self.matrix = parse_mount_matrix(matrix or "1,0,0;0,1,0;0,0,1")
        self.device = device

    def read(self) -> Tuple[float, float, float]:
        if self.device is None:
            if time.monotonic() < self.next_discovery:
                raise AutorotateError("waiting to reconnect the angle sensor")
            self.next_discovery = time.monotonic() + 3
            self.discover()
        try:
            values = []
            for axis in "xyz":
                raw = float((self.device / f"in_accel_{axis}_raw").read_text())
                offset, scale = 0.0, 1.0
                for suffix, fallback in (("offset", 0.0), ("scale", 1.0)):
                    selected = fallback
                    for name in (f"in_accel_{axis}_{suffix}", f"in_accel_{suffix}"):
                        path = self.device / name
                        if path.exists():
                            selected = float(path.read_text())
                            break
                    if suffix == "offset":
                        offset = selected
                    else:
                        scale = selected
                values.append((raw + offset) * scale)
            return tuple(sum(self.matrix[row*3+col] * values[col] for col in range(3)) for row in range(3))
        except (OSError, ValueError) as exc:
            self.device = None
            raise AutorotateError(f"cannot read the angle sensor: {exc}") from exc


@dataclass
class RotationSettler:
    candidate: Optional[str] = None
    deadline: Optional[float] = None
    delay: Optional[float] = None

    def update(self, target, eligible, delay, now):
        if target != self.candidate or delay != self.delay:
            self.candidate, self.deadline, self.delay = target, None, delay
        if not target or not eligible:
            self.deadline = None
            return False
        if self.deadline is None:
            self.deadline = now + delay
        return now >= self.deadline


def automatic_target(config: Dict[str, str], orientation: Optional[str]) -> Optional[str]:
    if bool_value(config.get("rotation_locked", "false")):
        locked = config.get("locked_rotation", "auto")
        return normalize_rotation(locked) if locked != "auto" else require_home_rotation(config)
    target = map_sensor_to_rotation(orientation, config) if orientation else require_home_rotation(config)
    return None if target in parse_blacklist(config) else target


def command_run(_: argparse.Namespace) -> int:
    from chuwi.session import read as session_read, write as session_write, inhibited
    config = read_config()
    if not bool_value(config.get("enabled", "true")):
        return 0
    if not adopt_graphical_environment(config) or os.environ.get("XDG_SESSION_TYPE") != "x11":
        raise AutorotateError("Rotation requires the active Cinnamon/Xfce X11 session")
    ensure_base_dirs()
    instance_lock = (STATE_DIR / "agent.lock").open("a")
    try:
        fcntl.flock(instance_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        instance_lock.close()
        return 0
    stop = threading.Event()
    handlers = {sig: signal.signal(sig, lambda *_: stop.set()) for sig in (signal.SIGINT, signal.SIGTERM)}
    from chuwi.events import DisplayEvents
    display_events = DisplayEvents().start()
    broker = SensorBroker().start()
    profile = identify()["profile"]
    angle_sensor = IIOAngleSensor()
    settler = RotationSettler()
    conflict = RotationConflict()
    applied = None
    generation = None
    next_check = next_state = 0
    recovery_started = False
    last_manual = None
    calibration_valid = True
    try:
        if config.get('rotation_locked') == 'true' and config.get('locked_rotation') in ROTATIONS:
            apply_rotation(config['locked_rotation'], config)
        else:
            reset_to_home(config, force=False)
        applied = detect_display(config).rotation
        while not stop.wait(.2):
            config = read_config(create=False)
            if not bool_value(config.get("enabled", "true")):
                break
            now = time.monotonic()
            sample = broker.snapshot()
            if generation != sample.generation:
                settler.update(None, False, 0, now)
                generation = sample.generation
            tablet = session_read("tablet")
            manual = tablet.get("manual", False) and tablet.get("phase") in ("trial", "locked")
            config["calibration_valid"] = str(calibration_valid).lower()
            decision = decide(config, sample, profile, manual=manual, inhibited=inhibited(), now=now)
            automatic = config.get("tablet_automatic") == "true"
            if automatic and not recovery_started:
                subprocess.Popen([str(Path(__file__).resolve().parent / "chuwi-control-panel"), "--recovery"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                recovery_started = True
            if not automatic:
                recovery_started = False
            manual_setting = (config.get("rotation_locked"), config.get("locked_rotation"))
            if manual_setting != last_manual:
                conflict = RotationConflict()
                last_manual = manual_setting
                try:
                    applied = detect_display(config).rotation
                except AutorotateError:
                    pass
            threshold, delay = validate_sensitivity(config.get("rotation_threshold_degrees", "45"), config.get("debounce_seconds", "1"))
            target = decision.rotation
            eligible, error = True, sample.error
            laptop = decision.posture in ("laptop", "inhibited") or (decision.posture == "unknown" and profile == "minibook-x-n150")
            if target and target != applied and threshold > 45 and not laptop and config.get("rotation_locked") != "true":
                try:
                    gravity = sample.gravity if sample.provider == "extended" else angle_sensor.read()
                    eligible = gravity is not None and angle_allows_rotation(sample.orientation, gravity, threshold)
                except (AutorotateError, OSError) as exc:
                    eligible, error = False, str(exc)
            due = settler.update(target if target != applied else None, eligible, delay, now)
            if display_events.consume():
                next_check = 0
            if now >= next_check:
                try:
                    observed, _ = display_snapshot(config)
                    from chuwi.config import fingerprint
                    recorded = config.get("calibration_fingerprint")
                    calibration_valid = not recorded or recorded == fingerprint(observed, sample.provider, sample.frame)
                    actual = observed["rotation"]
                    if actual != applied and actual != target:
                        if conflict.observe(True, now):
                            error = "Conflicting rotation manager: automatic writes paused; use a manual rotation or restart after resolving it"
                        applied = actual
                    elif actual != applied:
                        applied = actual
                    if not conflict.inhibited:
                        apply_touch_matrix(applied, config)
                except (AutorotateError, OSError, subprocess.SubprocessError) as exc:
                    error = str(exc)
                    calibration_valid = False
                next_check = now+5
            if due and not conflict.inhibited:
                try:
                    apply_rotation(target, config)
                    applied = target
                    settler.update(None, False, delay, now)
                except (AutorotateError, OSError, subprocess.SubprocessError) as exc:
                    error = str(exc)
                    conflict.inhibited = True
            if conflict.inhibited:
                error = "Conflicting rotation manager: automatic writes paused"
            state = {"orientation": sample.orientation, "sensor_valid": sample.fresh(now),
                     "sensor_provider": sample.provider, "sensor_frame": sample.frame,
                     "input_owner": sample.input_owner, "posture": decision.posture,
                     "hinge_degrees": sample.hinge_degrees if sample.fresh(now) else None,
                     "automatic_input_request": automatic and decision.lock_inputs and calibration_valid and not conflict.inhibited,
                     "reason": decision.reason, "last_error": error}
            session_write("controller", state)
            if now >= next_state:
                update_state(**state, last_sensor_orientation=sample.orientation,
                             angle_gate="Turn further" if not eligible else decision.reason,
                             heartbeat=datetime.now().astimezone().isoformat())
                next_state = now+1
        return 0
    finally:
        session_write("controller", {"sensor_valid": False, "automatic_input_request": False, "posture": "inhibited"})
        broker.close()
        display_events.close()
        for sig, handler in handlers.items():
            signal.signal(sig, handler)
        instance_lock.close()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=APP_NAME)
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("run", help="Run the monitor-sensor auto-rotation loop").set_defaults(
        func=command_run
    )
    subparsers.add_parser("on", help="Enable and start the user service").set_defaults(func=command_on)
    subparsers.add_parser("off", help="Stop, disable, and reset to HOME").set_defaults(func=command_off)
    status_parser = subparsers.add_parser("status", help="Show configuration and runtime status")
    status_parser.add_argument("--json", action="store_true")
    status_parser.set_defaults(func=command_status)
    for name in ("doctor", "audit"):
        audit_parser = subparsers.add_parser(name, help="Read-only hardware and session audit")
        audit_parser.add_argument("--json", action="store_true")
        audit_parser.add_argument("--dry-run", action="store_true")
        audit_parser.set_defaults(func=command_audit)
    subparsers.add_parser("calibrate-home", help="Save current display and rotation as HOME").set_defaults(
        func=command_calibrate_home
    )
    subparsers.add_parser("reset", help="Restore HOME display rotation and touch mapping").set_defaults(
        func=command_reset
    )
    lock_parser = subparsers.add_parser("lock", help="Hold the current rotation or resume following the sensor")
    lock_parser.add_argument("mode", choices=("on", "off"))
    lock_parser.set_defaults(func=command_lock)
    rotate_parser = subparsers.add_parser("rotate", help="Rotate manually and lock that orientation")
    rotate_parser.add_argument("rotation", choices=ROTATIONS)
    rotate_parser.set_defaults(func=command_rotate)
    enroll_parser = subparsers.add_parser('enroll-input', help='Enroll a verified internal HID identity; does not disable input')
    enroll_parser.add_argument('role', choices=('keyboard','touchpad','touchscreen'))
    enroll_parser.add_argument('node')
    enroll_parser.add_argument('--identity', required=True)
    enroll_parser.set_defaults(func=command_enroll_input)

    configure_parser = subparsers.add_parser("configure", help="Change a supported setting")
    configure_parser.add_argument("key", choices=("debounce_seconds", "rotation_threshold_degrees", "orientation_offset", "display", "tablet_automatic", "input_backend", "tablet_osk"))
    configure_parser.add_argument("value")
    configure_parser.set_defaults(func=command_configure)
    sensitivity_parser = subparsers.add_parser("sensitivity", help="Set the required turn angle and steady-posture delay")
    sensitivity_parser.add_argument("threshold")
    sensitivity_parser.add_argument("delay")
    sensitivity_parser.set_defaults(func=command_sensitivity)
    startup_parser = subparsers.add_parser("startup", help="Control rotation at desktop sign-in")
    startup_parser.add_argument("mode", choices=("on", "off", "status"))
    startup_parser.set_defaults(func=command_startup)
    subparsers.add_parser("session-start", help="Import the desktop environment and apply sign-in rotation").set_defaults(func=command_session_start)
    tablet_parser = subparsers.add_parser("tablet-mode", help="Show tablet status or restore keyboard and touchpad")
    tablet_parser.add_argument("mode", choices=("status", "off"))
    tablet_parser.set_defaults(func=command_tablet_mode)
    greeter_install_parser = subparsers.add_parser(
        "greeter-install", help="Install fixed LightDM login-screen rotation"
    )
    greeter_install_parser.add_argument(
        "--display",
        help="Display output for the greeter, default: saved config or auto-detected output",
    )
    greeter_install_parser.add_argument(
        "--rotation",
        choices=ROTATIONS,
        help="Greeter rotation, default: saved HOME rotation",
    )
    greeter_install_parser.add_argument(
        "--no-touch",
        action="store_true",
        help="Do not apply touchscreen coordinate mapping in the greeter",
    )
    greeter_install_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the files that would be installed without changing /etc or /usr/local",
    )
    greeter_install_parser.set_defaults(func=command_greeter_install)
    subparsers.add_parser(
        "greeter-status", help="Show LightDM login-screen rotation status"
    ).set_defaults(func=command_greeter_status)
    subparsers.add_parser(
        "greeter-uninstall", help="Restore the previous LightDM login-screen setup"
    ).set_defaults(func=command_greeter_uninstall)
    greeter_restore=subparsers.add_parser("greeter-restore",help="Restore a saved login-screen backup")
    greeter_restore.add_argument("backup",type=Path)
    greeter_restore.set_defaults(func=command_greeter_restore)

    test_parser = subparsers.add_parser(
        "test-rotation", help="Temporarily test a rotation, then return to HOME"
    )
    test_parser.add_argument("rotation", choices=ROTATIONS)
    test_parser.set_defaults(func=command_test_rotation)

    return parser


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        return args.func(args)
    except (AutorotateError, OSError, subprocess.SubprocessError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
