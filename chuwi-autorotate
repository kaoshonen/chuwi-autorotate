ROTATIONS = ("normal", "right", "inverted", "left")
ROTATION_DEGREES = {"normal": 0, "right": 90, "inverted": 180, "left": 270}
DEGREES_ROTATION = {value: key for key, value in ROTATION_DEGREES.items()}
SENSOR_DEGREES = {"normal": 0, "right-up": 90, "bottom-up": 180, "left-up": 270}
TOUCH_PATTERNS = ("touch", "touchscreen", "goodix", "silead", "wacom")

DEFAULT_CONFIG = OrderedDict(
    [
        ("enabled", "true"),
        ("display", "auto"),
        ("home_rotation", "auto"),
        ("orientation_offset", "right"),
        ("touch_enabled", "true"),
        ("debounce_seconds", "1.0"),
        ("startup_wait_seconds", "90"),
        ("blacklist_rotations", ""),
        ("log_file", "~/.local/state/chuwi-autorotate/chuwi-autorotate.log"),
