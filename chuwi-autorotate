GREETER_SCRIPT_TEXT = """#!/usr/bin/env bash
set -u

config_file="/etc/chuwi-autorotate/greeter.conf"
display="auto"
rotation="normal"
touch_enabled="true"

if [ -r "$config_file" ]; then
  # This file is installed root-owned by chuwi-autorotate greeter-install.
  # shellcheck disable=SC1090
  . "$config_file"
fi

case "${rotation:-normal}" in
  normal|right|inverted|left) ;;
  *) rotation="normal" ;;
esac

find_display() {
  local line name fallback
  while IFS= read -r line; do
    case "$line" in
      *" connected "*)
        name="${line%% *}"
        case "$name" in
          DSI-*|eDP-*|EDP-*|LVDS-*|LCD-*)
            printf "%s\\n" "$name"
            return 0
            ;;
        esac
        if [ -z "${fallback:-}" ]; then
          fallback="$name"
        fi
        ;;
    esac
  done < <(xrandr --query 2>/dev/null)

  if [ -n "${fallback:-}" ]; then
    printf "%s\\n" "$fallback"
  fi
}

if ! command -v xrandr >/dev/null 2>&1; then
  exit 0
fi

if [ "${display:-auto}" = "auto" ]; then
  display="$(find_display)"
fi

if [ -z "${display:-}" ]; then
  exit 0
fi

xrandr --output "$display" --rotate "$rotation" >/dev/null 2>&1 || exit 0

case "$rotation" in
  normal) matrix="1 0 0 0 1 0 0 0 1" ;;
  right) matrix="0 1 0 -1 0 1 0 0 1" ;;
  left) matrix="0 -1 1 1 0 0 0 0 1" ;;
  inverted) matrix="-1 0 1 0 -1 1 0 0 1" ;;
esac

case "${touch_enabled,,}" in
  1|yes|true|on|enabled) ;;
  *) exit 0 ;;
esac

if ! command -v xinput >/dev/null 2>&1; then
  exit 0
fi

xinput --list --short 2>/dev/null | while IFS= read -r line; do
  lower="$(printf "%s" "$line" | tr "[:upper:]" "[:lower:]")"
  case "$lower" in
    *touch*|*touchscreen*|*goodix*|*silead*|*wacom*) ;;
    *) continue ;;
  esac

  id="${line#*id=}"
  id="${id%%[[:space:]]*}"
  case "$id" in
    ""|*[!0-9]*) continue ;;
  esac

  # Some Goodix entries are not settable; ignore those and keep the greeter usable.
  xinput set-prop "$id" "Coordinate Transformation Matrix" $matrix >/dev/null 2>&1 || true
done

exit 0
"""

