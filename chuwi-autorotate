@dataclass
class DisplayInfo:
    name: str
    rotation: str
    primary: bool
    internal: bool
    active: bool
    raw: str


class AutorotateError(RuntimeError):
    pass


def expand_path(value: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(value)))


def ensure_base_dirs() -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)


def default_config_copy() -> OrderedDict:
    return OrderedDict(DEFAULT_CONFIG)


def read_config(create: bool = True) -> OrderedDict:
    if create:
        ensure_base_dirs()
        if not CONFIG_PATH.exists():
            write_config(default_config_copy())

    config = default_config_copy()
    extras = OrderedDict()

    if CONFIG_PATH.exists():
        for raw_line in CONFIG_PATH.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip()
            if key in config:
                config[key] = value
            else:
                extras[key] = value

    for key, value in extras.items():
        config[key] = value
    return config


def write_config(config: Dict[str, str]) -> None:
    ensure_base_dirs()
    output: List[str] = []
    for key, default_value in DEFAULT_CONFIG.items():
        output.append(f"{key}={config.get(key, default_value)}")

    extra_keys = [key for key in config.keys() if key not in DEFAULT_CONFIG]
    for key in extra_keys:
        output.append(f"{key}={config[key]}")

    atomic_write(CONFIG_PATH, "\n".join(output) + "\n")


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False) as handle:
        temporary = Path(handle.name)
        try:
            handle.write(text)
            handle.close()
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)


def bool_value(value: str) -> bool:
    return value.strip().lower() in {"1", "yes", "true", "on", "enabled"}


def get_float(config: Dict[str, str], key: str, default: float) -> float:
    try:
        return float(config.get(key, str(default)))
    except ValueError:
        return default


def log_path(config: Optional[Dict[str, str]] = None) -> Path:
    if config is None:
        path_text = DEFAULT_CONFIG["log_file"]
    else:
        path_text = config.get("log_file", DEFAULT_CONFIG["log_file"])
    return expand_path(path_text)


def log_event(message: str, config: Optional[Dict[str, str]] = None, also_print: bool = False) -> None:
    timestamp = datetime.now().astimezone().isoformat(timespec="seconds")
    line = f"{timestamp} {message}"
    try:
        path = log_path(config)
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(line + "\n")
    except OSError:
        pass

    if also_print:
        print(message, flush=True)


def load_state() -> Dict[str, str]:
    if not STATE_PATH.exists():
        return {}
    try:
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def update_state(**values: str) -> None:
    ensure_base_dirs()
    state = load_state()
    state.update(values)
    state["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
    atomic_write(STATE_PATH, json.dumps(state, indent=2, sort_keys=True) + "\n")


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def running_as_root() -> bool:
    return hasattr(os, "geteuid") and os.geteuid() == 0


def run_capture(args: List[str], timeout: Optional[float] = None) -> subprocess.CompletedProcess:
    return subprocess.run(args, text=True, capture_output=True, timeout=timeout or 10,
                          env={**os.environ, "LC_ALL": "C"})


def run_logged(args: List[str], config: Optional[Dict[str, str]] = None) -> subprocess.CompletedProcess:
    log_event(f"command: {shlex.join(args)}", config)
    return run_capture(args)


def require_command(name: str) -> None:
    if not command_exists(name):
        raise AutorotateError(f"{name} is not installed or is not in PATH")


def normalize_rotation(rotation: str) -> str:
    rotation = rotation.strip().lower()
    if rotation not in ROTATIONS:
        raise AutorotateError(f"invalid rotation '{rotation}', expected one of: {', '.join(ROTATIONS)}")
    return rotation


def parse_xrandr_rotation(line_tail: str) -> Tuple[str, bool]:
    tokens = line_tail.split()
    geometry_index: Optional[int] = None

    for index, token in enumerate(tokens):
        if re.match(r"^\d+x\d+[+-]\d+[+-]\d+$", token):
            geometry_index = index
            break

    if geometry_index is None:
        return "normal", False

    for token in tokens[geometry_index + 1 : geometry_index + 4]:
        cleaned = token.strip("()")
        if cleaned in ROTATIONS:
            return cleaned, True

    return "normal", True


def parse_xrandr_displays(output: str) -> List[DisplayInfo]:
    displays: List[DisplayInfo] = []
    for line in output.splitlines():
        match = re.match(r"^(\S+)\s+connected\b(.*)$", line)
        if not match:
            continue

        name = match.group(1)
        tail = match.group(2)
        rotation, active = parse_xrandr_rotation(tail)
        lower_name = name.lower()
        internal = lower_name.startswith(("edp", "lvds", "dsi", "lcd"))
        primary = " primary " in f" {tail} "
        displays.append(
            DisplayInfo(
                name=name,
                rotation=rotation,
                primary=primary,
                internal=internal,
                active=active,
                raw=line,
            )
        )
    return displays


def xrandr_displays() -> List[DisplayInfo]:
    require_command("xrandr")
    result = run_capture(["xrandr", "--query"])
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise AutorotateError(f"xrandr failed: {detail or 'unknown error'}")
    return parse_xrandr_displays(result.stdout)


def choose_display(displays: List[DisplayInfo], requested: str = "auto") -> DisplayInfo:
    if requested and requested != "auto":
        for display in displays:
            if display.name == requested and display.active and display.internal:
                return display
        raise AutorotateError(f"configured display '{requested}' is not connected")

    active = [display for display in displays if display.active]
    candidates = active
    if not candidates:
        raise AutorotateError("no connected display output found with xrandr")

    for display in candidates:
        if display.primary and display.internal:
            return display
    for display in candidates:
        if display.internal:
            return display
    raise AutorotateError("no active internal display; select a connector explicitly")


def detect_display(config: Optional[Dict[str, str]] = None, requested: Optional[str] = None) -> DisplayInfo:
    displays = xrandr_displays()
    display_name = requested
    if display_name is None and config is not None:
        display_name = config.get("display", "auto")
    if display_name is None:
        display_name = "auto"
    return choose_display(displays, display_name)


def parse_blacklist(config: Dict[str, str]) -> set:
    raw = config.get("blacklist_rotations", "")
    values = re.split(r"[\s,]+", raw.strip()) if raw.strip() else []
    return {value for value in values if value in ROTATIONS}


def map_sensor_to_rotation(sensor_orientation: str, config: Dict[str, str]) -> str:
    sensor_orientation = sensor_orientation.strip().lower()
    if sensor_orientation not in SENSOR_DEGREES:
        raise AutorotateError(f"unknown sensor orientation '{sensor_orientation}'")

    offset = config.get("orientation_offset", "right").strip().lower()
    if offset not in ROTATION_DEGREES:
        raise AutorotateError(
            f"invalid orientation_offset '{offset}', expected one of: {', '.join(ROTATIONS)}"
        )

    degrees = (ROTATION_DEGREES[offset] + SENSOR_DEGREES[sensor_orientation]) % 360
    return DEGREES_ROTATION[degrees]


def parse_sensor_orientation(line: str) -> Optional[str]:
    match = re.search(r"orientation(?:\s+changed)?\s*:\s*([a-z-]+)", line.lower())
    if not match:
        return None
    orientation = match.group(1)
    if orientation in SENSOR_DEGREES:
        return orientation
    return None


def detect_touchscreens() -> List[Dict[str, str]]:
    if not command_exists("xinput"):
        return []

    result = run_capture(["xinput", "--list", "--short"])
    if result.returncode != 0:
        return []

    devices: List[Dict[str, str]] = []
    seen = set()
    for line in result.stdout.splitlines():
        lower = line.lower()
        if "slave  pointer" not in lower or "touchpad" in lower:
            continue
        if not any(pattern in lower for pattern in ("touchscreen", "touch screen", "goodix", "silead")) and not ("wacom" in lower and "touch" in lower):
            continue

        match = re.search(r"\bid=(\d+)", line)
        if not match:
            continue

        device_id = match.group(1)
        if device_id in seen:
            continue

        raw_name = line.split("id=", 1)[0]
        name = re.sub(r"^[^A-Za-z0-9_./-]+", "", raw_name).strip()
        devices.append({"id": device_id, "name": name or f"id {device_id}"})
        seen.add(device_id)

    return devices


def viewport_touch_matrix(rotation: str, display_line: str, desktop_width: int, desktop_height: int) -> Tuple[str, ...]:
    """Map the panel's touch coordinates into its viewport, including external displays."""
    geometry = re.search(r"\b(\d+)x(\d+)([+-]\d+)([+-]\d+)\b", display_line)
    if not geometry or desktop_width <= 0 or desktop_height <= 0:
        raise AutorotateError("cannot determine touchscreen viewport")
    width, height, x, y = map(int, geometry.groups())
    sx, sy = width / desktop_width, height / desktop_height
    tx, ty = x / desktop_width, y / desktop_height
    r = tuple(float(value) for value in TOUCH_MATRICES[rotation])
    return tuple(f"{v:.8f}" for v in (
        sx*r[0], sx*r[1], sx*r[2]+tx, sy*r[3], sy*r[4], sy*r[5]+ty, 0, 0, 1))


def display_snapshot(config):
    from chuwi.display import parse_verbose
    result = run_capture(["xrandr", "--verbose"], timeout=4)
    if result.returncode:
        raise AutorotateError(result.stderr.strip() or "Cannot read XRandR geometry")
    requested = config.get("display", "auto")
    candidates = [d for d in parse_verbose(result.stdout) if d["active"] and d["internal"]
                  and (requested == "auto" or d["name"] == requested)]
    dimensions = re.search(r"current (\d+) x (\d+)", result.stdout)
    if len(candidates) != 1 or not dimensions:
        raise AutorotateError("Cannot uniquely identify the active internal panel")
    return candidates[0], tuple(map(int, dimensions.groups()))


def verified_touchscreens():
    from chuwi_tablet import XInputBackend, TabletError
    try:
        devices = [d for d in XInputBackend().devices() if d.role == "touchscreen" and d.enabled]
        from chuwi.inputs import enrolled
        selection = enrolled().get('touchscreen')
        if selection:
            devices = [d for d in devices if d.identity == selection['identity'] and d.syspath == selection['syspath']]
        if len(devices) > 1:
            raise AutorotateError('Multiple internal touch devices; explicit identity enrollment required')
        return devices
    except (TabletError, OSError) as exc:
        raise AutorotateError(str(exc)) from exc


def touch_baselines(display, desktop, devices):
    from chuwi.config import atomic
    from chuwi.display import inverse, multiply, touch_mapping, affine
    path = CONFIG_DIR / "touch-calibration.json"
    try:
        saved = json.loads(path.read_text()) if path.exists() else {}
    except (ValueError, OSError) as exc:
        raise AutorotateError("Cannot read saved touchscreen calibration") from exc
    changed = False
    for device in devices:
        key = display["identity"] + ":" + device.identity
        if key in saved:
            affine(saved[key])
            continue
        result = run_capture(["xinput", "list-props", device.xid], timeout=2)
        matrix = re.search(r"Coordinate Transformation Matrix \(\d+\):\s*([^\n]+)", result.stdout)
        if result.returncode or not matrix:
            raise AutorotateError("Cannot preserve touchscreen calibration")
        current = affine(tuple(float(v.strip()) for v in matrix[1].split(",")))
        saved[key] = multiply(inverse(touch_mapping(display, desktop)), current)
        changed = True
    if changed:
        atomic(path, (json.dumps(saved, sort_keys=True)+"\n").encode())
    return saved


def apply_touch_matrix(rotation: str, config: Dict[str, str]) -> None:
    if not bool_value(config.get("touch_enabled", "true")) or not command_exists("xinput"):
        return
    from chuwi.display import touch_mapping
    try:
        display, desktop = display_snapshot(config)
        devices = verified_touchscreens()
        saved = touch_baselines(display, desktop, devices)
        for device in devices:
            matrix = touch_mapping(display, desktop, saved[display["identity"] + ":" + device.identity])
            result = run_capture(["xinput", "list-props", device.xid], timeout=2)
            current = re.search(r"Coordinate Transformation Matrix \(\d+\):\s*([^\n]+)", result.stdout)
            if current:
                values = tuple(float(v.strip()) for v in current[1].split(","))
                if len(values) == 9 and all(abs(a-b) < 1e-5 for a,b in zip(values, matrix)):
                    continue
            fresh = [d for d in verified_touchscreens() if d.same_hardware(device)]
            if len(fresh) != 1:
                raise AutorotateError("Touch device changed during rotation; mapping deferred")
            result = run_capture(["xinput", "set-prop", fresh[0].xid, "Coordinate Transformation Matrix",
                                  *(f"{v:.9f}" for v in matrix)], timeout=2)
            if result.returncode:
                raise AutorotateError(result.stderr or "Touch mapping failed")
    except ValueError as exc:
        raise AutorotateError(str(exc)) from exc


def apply_rotation(rotation: str, config: Dict[str, str], force: bool = False) -> str:
    from chuwi.display import rotation_command
    if os.environ.get("XDG_SESSION_TYPE", "").lower() == "wayland":
        raise AutorotateError("Rotation is unsupported on Wayland; hardware diagnostics remain available")
    rotation = normalize_rotation(rotation)
    display, desktop = display_snapshot(config)
    try:
        args = rotation_command(display, rotation)
        if bool_value(config.get("touch_enabled", "true")) and command_exists("xinput"):
            touch_baselines(display, desktop, verified_touchscreens())
    except ValueError as exc:
        raise AutorotateError(str(exc)) from exc
    if display["rotation"] != rotation:
        result = run_capture(args, timeout=4)
        if result.returncode:
            raise AutorotateError(result.stderr or "XRandR rotation failed")
        updated, _ = display_snapshot(config)
        if updated["rotation"] != rotation or updated["refresh_hz"] != display["refresh_hz"]:
            raise AutorotateError("Display verification failed; automatic rotation must stop")
    update_state(last_applied_rotation=rotation, last_display=display["name"])
    apply_touch_matrix(rotation, config)
    return shlex.join(args)


def require_home_rotation(config: Dict[str, str]) -> str:
    home_rotation = config.get("home_rotation", "auto").strip().lower()
    if home_rotation == "auto":
        raise AutorotateError(
            "HOME rotation is not calibrated yet. Run: chuwi-autorotate calibrate-home"
        )
    return normalize_rotation(home_rotation)


def reset_to_home(config: Optional[Dict[str, str]] = None, force: bool = True) -> str:
    if config is None:
        config = read_config()
    home_rotation = require_home_rotation(config)
    return apply_rotation(home_rotation, config, force=force)


def systemctl_available() -> bool:
    return command_exists("systemctl")


def systemctl_user(args: List[str]) -> subprocess.CompletedProcess:
    if not systemctl_available():
        return subprocess.CompletedProcess(["systemctl", "--user", *args], 127, "", "systemctl not found")
    return run_capture(["systemctl", "--user", *args])


def parse_environment_lines(output: str) -> Dict[str, str]:
    values: Dict[str, str] = {}
    for raw_line in output.splitlines():
        if "=" not in raw_line:
            continue
        key, value = raw_line.split("=", 1)
        if key:
            values[key] = value
    return values


def user_systemd_environment() -> Dict[str, str]:
    result = systemctl_user(["show-environment"])
    if result.returncode != 0:
        return {}
    return parse_environment_lines(result.stdout)


def adopt_graphical_environment(config: Dict[str, str]) -> bool:
    if os.environ.get("DISPLAY"):
        return True

    if not os.environ.get("INVOCATION_ID"):
        return False

    wait_seconds = max(0.0, get_float(config, "startup_wait_seconds", 90.0))
    deadline = time.monotonic() + wait_seconds
    logged_wait = False

    while True:
        systemd_env = user_systemd_environment()
        for key in ("DISPLAY", "XAUTHORITY", "XDG_SESSION_TYPE"):
            value = systemd_env.get(key)
            if value:
                os.environ[key] = value

        if os.environ.get("DISPLAY"):
            if not os.environ.get("XAUTHORITY"):
                default_xauthority = Path.home() / ".Xauthority"
                if default_xauthority.exists():
                    os.environ["XAUTHORITY"] = str(default_xauthority)

            log_event(
                f"adopted graphical environment: DISPLAY={os.environ.get('DISPLAY')}, "
                f"XAUTHORITY={os.environ.get('XAUTHORITY', 'unset')}, "
                f"session={os.environ.get('XDG_SESSION_TYPE', 'unknown')}",
                config,
                also_print=True,
            )
            return True

        if time.monotonic() >= deadline:
            return False

        if not logged_wait:
            log_event(
                f"DISPLAY is not set; waiting up to {wait_seconds:.0f}s for graphical session environment",
                config,
                also_print=True,
            )
            logged_wait = True

        time.sleep(1)


def import_systemd_environment() -> None:
    if not systemctl_available():
        return
    systemctl_user(["import-environment", "DISPLAY", "XAUTHORITY", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP", "XDG_SESSION_DESKTOP"])


def ensure_service_file() -> None:
    SERVICE_DIR.mkdir(parents=True, exist_ok=True)
    if not SERVICE_PATH.exists() or SERVICE_PATH.read_text(encoding="utf-8") != SERVICE_TEXT:
        SERVICE_PATH.write_text(SERVICE_TEXT, encoding="utf-8")


def root_command(args: List[str]) -> subprocess.CompletedProcess:
    command = args
    if not running_as_root():
        if not command_exists("sudo"):
            return subprocess.CompletedProcess(args, 127, "", "sudo not found")
        command = ["sudo", *args]
    return subprocess.run(command, text=True)


def require_success(result: subprocess.CompletedProcess, action: str) -> None:
    if result.returncode != 0:
        detail = result.stderr.strip() if result.stderr else ""
        if not detail and result.stdout:
            detail = result.stdout.strip()
        raise AutorotateError(f"{action} failed{': ' + detail if detail else ''}")


def greeter_config_text(display: str, rotation: str, touch_enabled: bool) -> str:
    return "\n".join(
        [
            "# Installed by chuwi-autorotate greeter-install.",
            "# Read as data by /usr/local/bin/chuwi-autorotate-greeter.",
            f"display={shlex.quote(display)}",
            f"rotation={shlex.quote(rotation)}",
            f"touch_enabled={shlex.quote('true' if touch_enabled else 'false')}",
            "",
        ]
    )


def resolve_greeter_display(config: Dict[str, str], requested: Optional[str]) -> str:
    display = (requested or config.get("display", "auto")).strip()
    if display and display != "auto":
        if not re.fullmatch(r"(?:DSI|eDP|EDP|LVDS|LCD)-[A-Za-z0-9_.:-]+",display):
            raise AutorotateError("Login rotation requires a verified internal display connector")
        return display

    try:
        return detect_display(config, requested="auto").name
    except AutorotateError:
        state_display = load_state().get("last_display")
        if state_display:
            return state_display
        raise AutorotateError(
            "could not detect display for greeter setup; pass --display DSI-1"
        )


def greeter_paths():
    return (GREETER_SCRIPT_PATH,GREETER_CONFIG_PATH,LIGHTDM_CONF_PATH,GREETER_ORIGINALS_PATH)


def check_greeter_path(path):
    if path.is_symlink():raise AutorotateError(f"Refusing a symlink at {path}")
    if path.exists():
        info=path.stat()
        if info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise AutorotateError(f"Unexpected ownership or writable permissions at {path}")


def write_greeter_file(path, data, mode):
    check_greeter_path(path)
    path.parent.mkdir(mode=0o755,parents=True,exist_ok=True)
    check_greeter_path(path.parent)
    with tempfile.NamedTemporaryFile(dir=path.parent,delete=False) as handle:
        temporary=Path(handle.name)
        try:
            handle.write(data);handle.flush();os.fsync(handle.fileno())
            os.fchmod(handle.fileno(),mode);handle.close();temporary.replace(path)
        finally:temporary.unlink(missing_ok=True)


def backup_greeter_files():
    check_greeter_path(GREETER_BACKUP_ROOT)
    GREETER_BACKUP_ROOT.mkdir(mode=0o700,parents=True,exist_ok=True)
    backup=GREETER_BACKUP_ROOT/(datetime.now().strftime("greeter-%Y%m%d-%H%M%S-%f")+f"-{os.getpid()}")
    backup.mkdir(mode=0o700)
    entries=[]
    for index,path in enumerate(greeter_paths()):
        check_greeter_path(path)
        existed=path.exists()
        entries.append({"path":str(path),"existed":existed,"backup":str(index),
                        "mode":path.stat().st_mode & 0o777 if existed else 0})
        if existed:shutil.copy2(path,backup/str(index))
    write_greeter_file(backup/"manifest.json",json.dumps({"version":1,"files":entries},indent=2).encode(),0o600)
    return backup


def restore_greeter_files(backup):
    backup=Path(backup)
    if backup.is_symlink() or backup.parent.resolve()!=GREETER_BACKUP_ROOT.resolve():
        raise AutorotateError("Unexpected greeter backup location")
    check_greeter_path(backup)
    manifest_path=backup/"manifest.json";check_greeter_path(manifest_path)
    manifest=json.loads(manifest_path.read_text())
    entries=manifest.get("files",[])
    if manifest.get("version")!=1 or {entry["path"] for entry in entries}!={str(p) for p in greeter_paths()} or len(entries)!=4:
        raise AutorotateError("Invalid greeter backup manifest")
    for entry in entries:
        check_greeter_path(Path(entry["path"]))
        if not isinstance(entry["backup"],str) or not entry["backup"].isdigit() or not isinstance(entry["mode"],int) or entry["mode"] & ~0o777 or entry["mode"] & 0o022:
            raise AutorotateError("Invalid greeter backup entry")
        if entry["existed"]:
            saved=backup/entry["backup"];check_greeter_path(saved)
            if not saved.is_file():raise AutorotateError("Incomplete greeter backup")
    # Remove activation before touching the helper; restore any original hook last.
    LIGHTDM_CONF_PATH.unlink(missing_ok=True)
    for entry in sorted(entries,key=lambda e:e["path"]==str(LIGHTDM_CONF_PATH)):
        target=Path(entry["path"])
        if entry["existed"]:write_greeter_file(target,(backup/entry["backup"]).read_bytes(),entry["mode"])
        else:target.unlink(missing_ok=True)


def install_greeter_files(display: str, rotation: str, touch_enabled: bool):
    if not running_as_root():
        args=["/usr/bin/python3","-I",str(Path(__file__).resolve()),"greeter-install","--display",display,"--rotation",rotation]
        if not touch_enabled:args.append("--no-touch")
        require_success(root_command(args),"installing the login-screen rotation hook")
        return None
    for dependency in ("/usr/bin/timeout","/usr/bin/python3","/usr/bin/xrandr","/usr/bin/xinput","/usr/bin/udevadm","/usr/sbin/lightdm"):
        if not Path(dependency).is_file():raise AutorotateError(f"Missing login-screen dependency: {dependency}")
    manager=Path("/etc/X11/default-display-manager")
    if not manager.exists() or Path(manager.read_text().strip()).name!="lightdm":
        raise AutorotateError("This login hook requires LightDM")
    current=run_capture(["/usr/sbin/lightdm","--show-config"],timeout=5)
    require_success(current,"checking LightDM configuration")
    for key,value in re.findall(r"(display-setup-script|greeter-setup-script)=(.*)",current.stdout+current.stderr):
        if value.strip() and (value.strip()!=str(GREETER_SCRIPT_PATH) or not LIGHTDM_CONF_PATH.exists()):
            raise AutorotateError(f"Existing {key} must be preserved; refusing to replace it")
    backup=backup_greeter_files()
    try:
        write_greeter_file(GREETER_SCRIPT_PATH,GREETER_SCRIPT_TEXT.encode(),0o755)
        write_greeter_file(GREETER_CONFIG_PATH,greeter_config_text(display,rotation,touch_enabled).encode(),0o644)
        if not GREETER_ORIGINALS_PATH.exists():
            write_greeter_file(GREETER_ORIGINALS_PATH,json.dumps({"backup":str(backup)}).encode(),0o600)
        write_greeter_file(LIGHTDM_CONF_PATH,LIGHTDM_CONF_TEXT.encode(),0o644)
        checked=run_capture(["/usr/sbin/lightdm","--show-config"],timeout=5)
        require_success(checked,"validating the new LightDM configuration")
        output=checked.stdout+checked.stderr
        if any(f"{key}={GREETER_SCRIPT_PATH}" not in output for key in ("display-setup-script","greeter-setup-script")):
            raise AutorotateError("LightDM did not accept both login rotation hooks")
    except Exception:
        restore_greeter_files(backup)
        raise
    return backup


def greeter_status_summary() -> str:
    paths = [GREETER_SCRIPT_PATH, GREETER_CONFIG_PATH, LIGHTDM_CONF_PATH]
    existing = [path for path in paths if path.exists()]
    if len(existing) == len(paths):
        return f"installed ({GREETER_CONFIG_PATH})"
    if existing:
        return "partially installed"
    return "not installed"


def command_greeter_install(args: argparse.Namespace) -> int:
    config = read_config(create=not running_as_root())
    display = resolve_greeter_display(config, args.display)
    rotation = normalize_rotation(args.rotation or require_home_rotation(config))
    touch_enabled = bool_value(config.get("touch_enabled", "true")) and not args.no_touch

    if args.dry_run:
        print(f"Would install {GREETER_SCRIPT_PATH}:")
        print(GREETER_SCRIPT_TEXT.rstrip())
        print()
        print(f"Would install {GREETER_CONFIG_PATH}:")
        print(greeter_config_text(display, rotation, touch_enabled).rstrip())
        print()
        print(f"Would install {LIGHTDM_CONF_PATH}:")
        print(LIGHTDM_CONF_TEXT.rstrip())
        return 0

    backup=install_greeter_files(display, rotation, touch_enabled)
    print(f"Installed LightDM greeter rotation for {display} -> {rotation}.")
    print(f"LightDM config: {LIGHTDM_CONF_PATH}")
    print(f"Greeter script: {GREETER_SCRIPT_PATH}")
    if backup:
        print(f"Login-screen backup: {backup}")
        print(f"Rollback: sudo {sys.executable} -I {Path(__file__).resolve()} greeter-restore {backup}")
    print("It applies after the next LightDM restart or reboot. Your current desktop stays running.")
    return 0


def command_greeter_status(_: argparse.Namespace) -> int:
    print_result("LightDM greeter rotation", greeter_status_summary())
    print_result("LightDM config", str(LIGHTDM_CONF_PATH))
    print_result("greeter script", str(GREETER_SCRIPT_PATH))
    print_result("greeter config", str(GREETER_CONFIG_PATH))
    if GREETER_CONFIG_PATH.exists():
        print()
        print(GREETER_CONFIG_PATH.read_text(encoding="utf-8").rstrip())
    return 0


def command_greeter_uninstall(_: argparse.Namespace) -> int:
    if not running_as_root():
        result=root_command(["/usr/bin/python3","-I",str(Path(__file__).resolve()),"greeter-uninstall"])
        require_success(result,"restoring the previous login-screen setup")
        return 0
    if GREETER_ORIGINALS_PATH.exists():
        check_greeter_path(GREETER_ORIGINALS_PATH)
        restore_greeter_files(Path(json.loads(GREETER_ORIGINALS_PATH.read_text())["backup"]))
    else:
        for path in (LIGHTDM_CONF_PATH,GREETER_CONFIG_PATH,GREETER_SCRIPT_PATH):
            check_greeter_path(path);path.unlink(missing_ok=True)
    print("Previous login-screen setup restored. Current desktop and backups preserved.")
    return 0


def command_greeter_restore(args: argparse.Namespace) -> int:
    if not running_as_root():
        require_success(root_command(["/usr/bin/python3","-I",str(Path(__file__).resolve()),"greeter-restore",str(args.backup)]),"restoring login-screen backup")
        return 0
    restore_greeter_files(args.backup)
    print("Login-screen backup restored. It applies after the next LightDM restart or reboot.")
    return 0


def user_service_state() -> str:
    if not systemctl_available():
        return "systemctl not found"
    result = systemctl_user(["is-active", SERVICE_NAME])
    text = (result.stdout or result.stderr).strip()
    return text or "inactive"


def iio_sensor_proxy_status() -> str:
    if not systemctl_available():
        return "systemctl not found"

    active = run_capture(["systemctl", "is-active", "iio-sensor-proxy.service"])
    active_text = (active.stdout or active.stderr).strip()
    if active.returncode == 0:
        return active_text

    listed = run_capture(["systemctl", "list-unit-files", "iio-sensor-proxy.service"])
    if listed.returncode == 0 and "iio-sensor-proxy.service" in listed.stdout:
        if active_text in {"active", "activating"}:
            return active_text
        return f"installed, {active_text or 'not active'}"
    return "not available"


def print_result(label: str, value: str) -> None:
    print(f"{label}: {value}")


def command_calibrate_home(_: argparse.Namespace) -> int:
    config = read_config()
    display = detect_display(requested="auto")
    orientation = read_sensor_once()
    from chuwi.session import read as read_session
    from chuwi.config import fingerprint
    cached = read_session("controller")
    sample = globals().get("_calibration_sample")
    frame = cached.get("sensor_frame") or (sample.frame if sample else "sensorproxy-standard-v1")
    provider = cached.get("sensor_provider") or (sample.provider if sample else "standard")
    config["sensor_frame"] = frame
    config["display"] = display.name
    if display.raw:
        observed, _ = display_snapshot(config)
        config["calibration_fingerprint"] = fingerprint(observed, provider, frame)
    offset = (ROTATION_DEGREES[display.rotation] - SENSOR_DEGREES[orientation]) % 360
    config["display"] = display.name
    config["home_rotation"] = display.rotation
    config["orientation_offset"] = DEGREES_ROTATION[offset]
    write_config(config)
    update_state(last_display=display.name, home_rotation=display.rotation, last_sensor_orientation=orientation)
    print(f"HOME calibrated to display {display.name} with rotation {display.rotation}.")
    print(f"Sensor {orientation}; calibrated offset {config['orientation_offset']}.")
    print(f"Config written to {CONFIG_PATH}")
    return 0


def sensor_command() -> List[str]:
    command = ["monitor-sensor", "--accel"]
    return ["stdbuf", "-oL", *command] if command_exists("stdbuf") else command


def read_sensor_once(timeout: float = 5) -> str:
    from chuwi.session import read
    cached = read("controller")
    if cached.get("sensor_valid") and cached.get("orientation") in SENSOR_DEGREES:
        return cached["orientation"]
    if cached or user_service_state() == 'active':
        raise AutorotateError('The running controller has no fresh calibration sample; wait for sensor recovery or stop it before using a temporary claim')
    try:
        global _calibration_sample
        _calibration_sample = sample_once(timeout)
        return _calibration_sample.orientation
    except RuntimeError as exc:
        raise AutorotateError(str(exc)) from exc


def command_lock(args: argparse.Namespace) -> int:
    config = read_config()
    lock = args.mode == "on"
    if lock:
        config["locked_rotation"] = detect_display(config).rotation
    config["rotation_locked"] = str(lock).lower()
    write_config(config)
    print("Rotation locked." if lock else "Rotation unlocked; following the sensor.")
    return 0


def command_rotate(args: argparse.Namespace) -> int:
    config = read_config()
    before = config.copy()
    config["rotation_locked"] = "true"
    config["locked_rotation"] = normalize_rotation(args.rotation)
    write_config(config)
    try:
        apply_rotation(args.rotation, config, force=True)
    except AutorotateError:
        write_config(before)
        raise
    print(f"Rotation locked to {args.rotation}. Unlock to resume automatic rotation.")
    return 0


def command_configure(args: argparse.Namespace) -> int:
    config = read_config()
    if args.key == "debounce_seconds":
        try:
            value = float(args.value)
        except ValueError:
            raise AutorotateError("rotation delay must be a number")
        if not 0.3 <= value <= 3.0:
            raise AutorotateError("rotation delay must be between 0.3 and 3 seconds")
    elif args.key == "orientation_offset":
        normalize_rotation(args.value)
    elif args.key == "rotation_threshold_degrees":
        validate_sensitivity(args.value, config.get("debounce_seconds", "1"))
    elif args.key == "display":
        detect_display(requested=args.value)
    if args.key == "tablet_automatic" and args.value not in ("true", "false"):
        raise AutorotateError("tablet_automatic must be true or false")
    if args.key == "input_backend" and args.value not in ("auto", "xinput", "ec"):
        raise AutorotateError("input_backend must be auto, xinput or ec")
    if args.key == "tablet_osk" and args.value not in ("manual", "automatic"):
        raise AutorotateError("tablet_osk must be manual or automatic")
    config[args.key] = args.value
    write_config(config)
    print(f"Saved {args.key}={args.value}.")
    return 0


def validate_sensitivity(threshold, delay) -> Tuple[float, float]:
    try:
        threshold, delay = float(threshold), float(delay)
    except (ValueError, TypeError):
        raise AutorotateError("rotation threshold and delay must be numbers")
    if not math.isfinite(threshold) or not 45 <= threshold <= 85:
        raise AutorotateError("rotation threshold must be between 45 and 85 degrees")
    if not math.isfinite(delay) or not 0.3 <= delay <= 3:
        raise AutorotateError("rotation delay must be between 0.3 and 3 seconds")
    return threshold, delay


def command_sensitivity(args: argparse.Namespace) -> int:
    threshold, delay = validate_sensitivity(args.threshold, args.delay)
    config = read_config()
    config["rotation_threshold_degrees"] = f"{threshold:g}"
    config["debounce_seconds"] = f"{delay:g}"
    write_config(config)
    print(f"Rotation now requires a {threshold:g}° turn and {delay:g} seconds of steady posture.")
    return 0


def command_tablet_mode(args: argparse.Namespace) -> int:
    guard = Path(__file__).resolve().parent / "chuwi-tablet-guard"
    if not guard.is_file():
        raise AutorotateError("The protected tablet guardian is not installed")
    if args.mode == "status":
        result = run_capture([str(guard), "--status"], timeout=4)
    else:
        from chuwi.session import inhibit
        inhibit()
        stop = run_capture(["systemctl", "--user", "stop", "chuwi-tablet-guard.service"], timeout=18)
        result = run_capture([str(guard), "--restore"], timeout=15)
        if stop.returncode not in (0, 5):
            print((stop.stderr or stop.stdout).strip(), file=sys.stderr)
            return 1
    if result.stdout:
        print(result.stdout.strip())
    if result.stderr:
        print(result.stderr.strip(), file=sys.stderr)
    if result.returncode == 0 and args.mode == "off":
        print("Tablet mode off; keyboard and touchpad restored.")
    return result.returncode


def command_startup(args: argparse.Namespace) -> int:
    if args.mode == "status":
        print("enabled" if AUTOSTART_PATH.exists() else "disabled")
    elif args.mode == "off":
        result = systemctl_user(["disable", SERVICE_NAME])
        if result.returncode not in (0, 5):
            raise AutorotateError((result.stderr or result.stdout).strip())
        AUTOSTART_PATH.unlink(missing_ok=True)
        print("Start at sign-in disabled. The current session is unchanged.")
    else:
        executable = str(Path(__file__).resolve())
        escaped = executable.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`").replace("%", "%%")
        atomic_write(AUTOSTART_PATH, "[Desktop Entry]\nType=Application\nName=CHUWI Rotation Agent\n"
                     f'Exec="{escaped}" session-start\nTerminal=false\n'
                     "X-GNOME-Autostart-enabled=true\nX-GNOME-Autostart-Delay=5\n")
        print("Rotation will start at desktop sign-in.")
    return 0


def command_session_start(_: argparse.Namespace) -> int:
    config = read_config()
    import_systemd_environment()
    if bool_value(config.get("enabled", "true")):
        result = systemctl_user(["restart", SERVICE_NAME])
        require_success(result, "start rotation service")
    else:
        reset_to_home(config)
    return 0


def command_reset(_: argparse.Namespace) -> int:
    config = read_config()
    if bool_value(config.get("rotation_locked", "false")):
        config["locked_rotation"] = require_home_rotation(config)
        write_config(config)
    command_text = reset_to_home(config, force=True)
    print(f"Reset to HOME landscape mode using: {command_text}")
    return 0


def command_test_rotation(args: argparse.Namespace) -> int:
    config = read_config()
    target = normalize_rotation(args.rotation)
    require_home_rotation(config)
    display = detect_display(config)
    command_text = shlex.join(["xrandr", "--output", display.name, "--rotate", target])
    print(f"Testing rotation for 8 seconds: {command_text}")
    try:
        apply_rotation(target, config, force=True)
        time.sleep(8)
    finally:
        print("Returning to HOME landscape mode.")
        reset_to_home(config, force=True)
    return 0


def command_on(_: argparse.Namespace) -> int:
    config = read_config()
    config["enabled"] = "true"
    write_config(config)
    ensure_service_file()
    import_systemd_environment()

    daemon_reload = systemctl_user(["daemon-reload"])
    if daemon_reload.returncode != 0:
        print((daemon_reload.stderr or daemon_reload.stdout).strip())
        return daemon_reload.returncode

    # The desktop autostart entry owns persistence and provides fresh X11 credentials.
    # Starting at default.target can race Cinnamon or reuse a previous session's DISPLAY.
    disable = systemctl_user(["disable", SERVICE_NAME])
    if disable.returncode not in (0, 5):
        print((disable.stderr or disable.stdout).strip())
        return disable.returncode
    start = systemctl_user(["restart", SERVICE_NAME])
    if start.returncode != 0:
        print((start.stderr or start.stdout).strip())
        return start.returncode

    print("Auto-rotation is enabled.")
    status = systemctl_user(["--no-pager", "--lines=12", "status", SERVICE_NAME])
    print((status.stdout or status.stderr).rstrip())
    return 0 if status.returncode in (0, 3) else status.returncode


def command_off(_: argparse.Namespace) -> int:
    config = read_config()
    config["enabled"] = "false"
    write_config(config)

    guard = Path(__file__).resolve().parent / "chuwi-tablet-guard"
    recovery_failed = False
    if guard.exists():
        recovery_failed = command_tablet_mode(argparse.Namespace(mode="off")) != 0

    stop = systemctl_user(["disable", "--now", SERVICE_NAME])
    if stop.returncode != 0 and stop.returncode != 5:
        detail = (stop.stderr or stop.stdout).strip()
        if detail:
            print(detail)

    reset_failed = False
    try:
        command_text = reset_to_home(config, force=True)
        print(f"Reset to HOME landscape mode using: {command_text}")
    except AutorotateError as exc:
        reset_failed = True
        print(f"Could not reset to HOME: {exc}")

    print("Auto-rotation is disabled. Re-enable with: chuwi-autorotate on")
    return 1 if reset_failed or recovery_failed else 0


def command_status(args: argparse.Namespace) -> int:
    config = read_config(create=False)
    state = load_state()
    if getattr(args, "json", False):
        from chuwi.hardware import audit
        from chuwi.session import read as read_session
        report = audit(config, read_session("controller"))
