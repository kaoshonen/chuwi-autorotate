def bool_value(value: str) -> bool:
    return value.strip().lower() in {"1", "yes", "true", "on", "enabled"}


def command_path() -> str:
    discovered = shutil.which("chuwi-autorotate")
    if discovered:
        return discovered
    if COMMAND_PATH.exists():
        return str(COMMAND_PATH)
    return str(LOCAL_COMMAND_PATH)


def run_command(args: Iterable[str], timeout: float = 30, use_pkexec: bool = False) -> subprocess.CompletedProcess:
    command: List[str] = [command_path(), *args]
    if use_pkexec:
        pkexec = shutil.which("pkexec")
        if not pkexec:
            return subprocess.CompletedProcess(command, 127, "", "pkexec is not installed")
        command = [pkexec, *command]

    return subprocess.run(command, text=True, capture_output=True, timeout=timeout)


def run_process(command: List[str], timeout: float = 15) -> subprocess.CompletedProcess:
    return subprocess.run(command, text=True, capture_output=True, timeout=timeout)


def parse_status(output: str) -> Dict[str, str]:
    status: Dict[str, str] = {}
    for raw_line in output.splitlines():
        if ": " not in raw_line:
            continue
        key, value = raw_line.split(": ", 1)
        status[key.strip()] = value.strip()
    return status


def parse_xinput_devices(output: str) -> List[Dict[str, str]]:
    devices: List[Dict[str, str]] = []
    pattern = re.compile(r"\bid=(\d+)\s+\[([^\]]+)\]")
    for line in output.splitlines():
        match = pattern.search(line)
        if not match:
            continue
        raw_name = line[: match.start()].strip()
        name = re.sub(r"^[^\w]+", "", raw_name).strip()
        devices.append({"name": name, "id": match.group(1), "type": match.group(2).strip()})
    return devices


def discover_tablet_lock_devices() -> Dict[str, object]:
    xinput = shutil.which("xinput")
    if not xinput:
        return {
            "available": False,
            "error": "xinput is not installed",
            "xinput": "",
            "devices": [],
            "missing": list(TABLET_LOCK_DEVICE_NAMES),
        }

    result = run_process([xinput, "--list", "--short"], timeout=5)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip() or "xinput --list failed"
        return {
            "available": False,
            "error": detail,
            "xinput": xinput,
            "devices": [],
            "missing": list(TABLET_LOCK_DEVICE_NAMES),
        }

    all_devices = parse_xinput_devices(result.stdout)
    matched: List[Dict[str, str]] = []
    missing: List[str] = []
    for target_name in TABLET_LOCK_DEVICE_NAMES:
        device = next((candidate for candidate in all_devices if candidate["name"] == target_name), None)
        if device:
            matched.append(device)
        else:
            missing.append(target_name)

    return {
        "available": True,
        "error": "",
        "xinput": xinput,
        "devices": matched,
        "missing": missing,
    }


def xinput_device_enabled(xinput: str, device_id: str) -> Optional[bool]:
    result = run_process([xinput, "list-props", device_id], timeout=5)
    if result.returncode != 0:
        return None

    for line in result.stdout.splitlines():
        if "Device Enabled" not in line or ":" not in line:
            continue
        value = line.rsplit(":", 1)[1].strip().split()
        if not value:
            return None
        return value[0] == "1"
    return None


def tablet_lock_status() -> Dict[str, object]:
    discovery = discover_tablet_lock_devices()
    devices: List[Dict[str, object]] = []
    xinput = str(discovery.get("xinput", ""))

    for device in discovery.get("devices", []):
        item = dict(device)
        item["enabled"] = xinput_device_enabled(xinput, str(item["id"])) if xinput else None
        devices.append(item)

    disabled_count = sum(1 for device in devices if device.get("enabled") is False)
    locked = (
        bool(devices)
        and disabled_count == len(TABLET_LOCK_DEVICE_NAMES)
        and not discovery.get("missing")
    )
    partial = disabled_count > 0 and not locked

    return {
        "available": bool(discovery.get("available")),
        "error": discovery.get("error", ""),
        "devices": devices,
        "missing": discovery.get("missing", []),
        "locked": locked,
        "partial": partial,
    }


def tablet_lock_status_process() -> subprocess.CompletedProcess:
    return subprocess.CompletedProcess(
        ["xinput", "tablet-lock-status"],
        0,
        json.dumps(tablet_lock_status()),
        "",
    )


def set_tablet_lock_process(lock: bool) -> subprocess.CompletedProcess:
    discovery = discover_tablet_lock_devices()
    devices = discovery.get("devices", [])
    missing = discovery.get("missing", [])
    xinput = str(discovery.get("xinput", ""))

    if not discovery.get("available"):
        detail = str(discovery.get("error", "xinput is unavailable"))
        return subprocess.CompletedProcess([], 1, json.dumps(tablet_lock_status()), detail)

    if lock and missing:
        detail = "Missing expected internal input devices: " + ", ".join(str(name) for name in missing)
        return subprocess.CompletedProcess([], 1, json.dumps(tablet_lock_status()), detail)

    if not devices:
        return subprocess.CompletedProcess([], 1, json.dumps(tablet_lock_status()), "No matching input devices found")

    action = "disable" if lock else "enable"
    failures: List[str] = []
    for device in devices:
        result = run_process([xinput, action, str(device["id"])], timeout=5)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip() or f"xinput {action} failed"
            failures.append(f"{device['name']}: {detail}")

    status = tablet_lock_status()
    return subprocess.CompletedProcess(
        [xinput, action],
        1 if failures else 0,
        json.dumps(status),
        "\n".join(failures),
    )


def read_config() -> OrderedDict:
    config = OrderedDict(DEFAULT_CONFIG)
    extras = OrderedDict()

    if CONFIG_PATH.exists():
        for raw_line in CONFIG_PATH.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip()
            if key in config:
                config[key] = value
            else:
                extras[key] = value

    for key, value in extras.items():
        config[key] = value
    return config


def write_config(config: Dict[str, str]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines: List[str] = []
    for key, default_value in DEFAULT_CONFIG.items():
        lines.append(f"{key}={config.get(key, default_value)}")

    for key, value in config.items():
        if key not in DEFAULT_CONFIG:
            lines.append(f"{key}={value}")

    CONFIG_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


def read_state() -> Dict[str, str]:
    if not STATE_PATH.exists():
        return {}
    try:
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def sensor_age_text(updated_at: str) -> str:
    if not updated_at:
        return "no sensor event recorded"

    try:
        updated = datetime.fromisoformat(updated_at)
        now = datetime.now(updated.tzinfo) if updated.tzinfo else datetime.now()
        seconds = max(0, int((now - updated).total_seconds()))
    except ValueError:
        return f"last event: {updated_at}"

    if seconds < 5:
        return "last event just now"
    if seconds < 60:
        return f"last event {seconds}s ago"
    minutes = seconds // 60
    if minutes < 60:
        return f"last event {minutes}m ago"
    hours = minutes // 60
    return f"last event {hours}h ago"


class SensorDrawing(Gtk.DrawingArea):
    def __init__(self) -> None:
        super().__init__()
        self.orientation = "unknown"
        self.set_size_request(150, 112)
        self.connect("draw", self.on_draw)

    def set_orientation(self, orientation: str) -> None:
        self.orientation = orientation
        self.queue_draw()

    def on_draw(self, area: Gtk.DrawingArea, context) -> bool:
        allocation = area.get_allocation()
        width = allocation.width
        height = allocation.height
        center_x = width / 2
        center_y = height / 2

        context.set_source_rgb(0.94, 0.96, 0.98)
        rounded_rectangle(context, 8, 8, width - 16, height - 16, 10)
        context.fill()

        context.save()
        context.translate(center_x, center_y)
        context.rotate(math.radians(SENSOR_ANGLES.get(self.orientation, 0)))

        if self.orientation not in SENSOR_ANGLES:
            context.set_source_rgb(0.55, 0.60, 0.65)
        else:
            context.set_source_rgb(0.10, 0.42, 0.82)
        rounded_rectangle(context, -42, -34, 84, 56, 7)
        context.fill()

        context.set_source_rgb(0.84, 0.91, 0.98)
        rounded_rectangle(context, -34, -27, 68, 42, 4)
        context.fill()

        context.set_source_rgb(0.15, 0.21, 0.27)
        rounded_rectangle(context, -52, 23, 104, 20, 5)
        context.fill()

        context.set_source_rgb(0.70, 0.77, 0.83)
        rounded_rectangle(context, -31, 28, 62, 6, 3)
        context.fill()

        context.restore()

        if self.orientation not in SENSOR_ANGLES:
            context.set_source_rgb(0.38, 0.42, 0.46)
            context.set_font_size(24)
            context.move_to(center_x - 7, center_y + 9)
            context.show_text("?")

        return False


def rounded_rectangle(context, x: float, y: float, width: float, height: float, radius: float) -> None:
    context.new_sub_path()
    context.arc(x + width - radius, y + radius, radius, -math.pi / 2, 0)
    context.arc(x + width - radius, y + height - radius, radius, 0, math.pi / 2)
    context.arc(x + radius, y + height - radius, radius, math.pi / 2, math.pi)
    context.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
    context.close_path()


