        if self.window is None:
            self.window = self.build_window()
            self.window.show_all()
        self.window.present()
        self.refresh()
        if self.sensor_timer_id is None:
            self.sensor_timer_id = GLib.timeout_add_seconds(1, self.update_sensor_indicator)
        self.update_sensor_indicator()

    def do_shutdown(self) -> None:
        if not (self.tablet_lock_active or self.tablet_lock_partial):
            restore_onboard_keyboard_process(stop_started=False)
        if self.sensor_timer_id is not None:
            GLib.source_remove(self.sensor_timer_id)
            self.sensor_timer_id = None
        Gtk.Application.do_shutdown(self)

