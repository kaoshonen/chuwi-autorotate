def bool_value(value: str) -> bool:
    return value.strip().lower() in {"1", "yes", "true", "on", "enabled"}


def command_path() -> str:
    discovered = shutil.which("chuwi-autorotate")
    if discovered:
        return discovered
    if COMMAND_PATH.exists():
        return str(COMMAND_PATH)
    return str(LOCAL_COMMAND_PATH)


def run_command(args: Iterable[str], timeout: float = 30, use_pkexec: bool = False) -> subprocess.CompletedProcess:
    command: List[str] = [command_path(), *args]
    if use_pkexec:
        pkexec = shutil.which("pkexec")
        if not pkexec:
            return subprocess.CompletedProcess(command, 127, "", "pkexec is not installed")
        command = [pkexec, *command]

    return subprocess.run(command, text=True, capture_output=True, timeout=timeout)


def run_process(command: List[str], timeout: float = 15) -> subprocess.CompletedProcess:
    return subprocess.run(command, text=True, capture_output=True, timeout=timeout)


def restart_sensor_stack_process() -> subprocess.CompletedProcess:
    systemctl = shutil.which("systemctl")
    if not systemctl:
        return subprocess.CompletedProcess([], 127, "", "systemctl is not installed")

    pkexec = shutil.which("pkexec")
    if not pkexec:
        return subprocess.CompletedProcess([], 127, "", "pkexec is not installed")

    system_result = run_process(
        [pkexec, systemctl, "restart", "iio-sensor-proxy.service"],
        timeout=180,
    )
    if system_result.returncode != 0:
        detail = (system_result.stderr or system_result.stdout).strip() or "iio-sensor-proxy restart failed"
        return subprocess.CompletedProcess(system_result.args, system_result.returncode, system_result.stdout, detail)

    user_result = run_process(
        [systemctl, "--user", "restart", "chuwi-autorotate.service"],
        timeout=30,
    )
    if user_result.returncode != 0:
        detail = (user_result.stderr or user_result.stdout).strip() or "chuwi-autorotate restart failed"
        return subprocess.CompletedProcess(user_result.args, user_result.returncode, user_result.stdout, detail)

    return subprocess.CompletedProcess(
        ["restart-sensor-stack"],
        0,
        "Restarted iio-sensor-proxy and chuwi-autorotate.",
        "",
    )


def parse_status(output: str) -> Dict[str, str]:
    status: Dict[str, str] = {}
    for raw_line in output.splitlines():
        if ": " not in raw_line:
            continue
        key, value = raw_line.split(": ", 1)
        status[key.strip()] = value.strip()
    return status


def parse_xinput_devices(output: str) -> List[Dict[str, str]]:
    devices: List[Dict[str, str]] = []
    pattern = re.compile(r"\bid=(\d+)\s+\[([^\]]+)\]")
    for line in output.splitlines():
        match = pattern.search(line)
        if not match:
            continue
        raw_name = line[: match.start()].strip()
        name = re.sub(r"^[^\w]+", "", raw_name).strip()
        devices.append({"name": name, "id": match.group(1), "type": match.group(2).strip()})
    return devices


def discover_tablet_lock_devices() -> Dict[str, object]:
    xinput = shutil.which("xinput")
    if not xinput:
        return {
            "available": False,
            "error": "xinput is not installed",
            "xinput": "",
            "devices": [],
            "missing": list(TABLET_LOCK_DEVICE_NAMES),
        }

    result = run_process([xinput, "--list", "--short"], timeout=5)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip() or "xinput --list failed"
        return {
            "available": False,
            "error": detail,
            "xinput": xinput,
            "devices": [],
            "missing": list(TABLET_LOCK_DEVICE_NAMES),
        }

    all_devices = parse_xinput_devices(result.stdout)
    matched: List[Dict[str, str]] = []
    missing: List[str] = []
    for target_name in TABLET_LOCK_DEVICE_NAMES:
        device = next((candidate for candidate in all_devices if candidate["name"] == target_name), None)
        if device:
            matched.append(device)
        else:
            missing.append(target_name)

    return {
        "available": True,
        "error": "",
        "xinput": xinput,
        "devices": matched,
        "missing": missing,
    }


def xinput_device_enabled(xinput: str, device_id: str) -> Optional[bool]:
    result = run_process([xinput, "list-props", device_id], timeout=5)
    if result.returncode != 0:
        return None

    for line in result.stdout.splitlines():
        if "Device Enabled" not in line or ":" not in line:
            continue
        value = line.rsplit(":", 1)[1].strip().split()
        if not value:
            return None
        return value[0] == "1"
    return None


def tablet_lock_status() -> Dict[str, object]:
    discovery = discover_tablet_lock_devices()
    devices: List[Dict[str, object]] = []
    xinput = str(discovery.get("xinput", ""))

    for device in discovery.get("devices", []):
        item = dict(device)
        item["enabled"] = xinput_device_enabled(xinput, str(item["id"])) if xinput else None
        devices.append(item)

    disabled_count = sum(1 for device in devices if device.get("enabled") is False)
    locked = (
        bool(devices)
        and disabled_count == len(TABLET_LOCK_DEVICE_NAMES)
        and not discovery.get("missing")
    )
    partial = disabled_count > 0 and not locked

    return {
        "available": bool(discovery.get("available")),
        "error": discovery.get("error", ""),
        "devices": devices,
        "missing": discovery.get("missing", []),
        "locked": locked,
        "partial": partial,
    }


def tablet_lock_status_process() -> subprocess.CompletedProcess:
    return subprocess.CompletedProcess(
        ["xinput", "tablet-lock-status"],
        0,
        json.dumps(tablet_lock_status()),
        "",
    )


def set_tablet_lock_process(lock: bool) -> subprocess.CompletedProcess:
    discovery = discover_tablet_lock_devices()
    devices = discovery.get("devices", [])
    missing = discovery.get("missing", [])
    xinput = str(discovery.get("xinput", ""))

    if not discovery.get("available"):
        detail = str(discovery.get("error", "xinput is unavailable"))
        return subprocess.CompletedProcess([], 1, json.dumps(tablet_lock_status()), detail)

    if lock and missing:
        detail = "Missing expected internal input devices: " + ", ".join(str(name) for name in missing)
        return subprocess.CompletedProcess([], 1, json.dumps(tablet_lock_status()), detail)

    if not devices:
        return subprocess.CompletedProcess([], 1, json.dumps(tablet_lock_status()), "No matching input devices found")

    action = "disable" if lock else "enable"
    failures: List[str] = []
    for device in devices:
        result = run_process([xinput, action, str(device["id"])], timeout=5)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip() or f"xinput {action} failed"
            failures.append(f"{device['name']}: {detail}")

    status = tablet_lock_status()
    return subprocess.CompletedProcess(
        [xinput, action],
        1 if failures else 0,
        json.dumps(status),
        "\n".join(failures),
    )


def gsettings_get_bool(schema: str, key: str) -> tuple[Optional[bool], str]:
    gsettings = shutil.which("gsettings")
    if not gsettings:
        return None, "gsettings is not installed"

    result = run_process([gsettings, "get", schema, key], timeout=5)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip() or f"Could not read {schema} {key}"
        return None, detail

    value = result.stdout.strip().lower()
    if value in {"true", "false"}:
        return value == "true", ""
    return None, f"Unexpected gsettings value for {schema} {key}: {value}"


def gsettings_set_bool(schema: str, key: str, value: bool) -> Optional[str]:
    gsettings = shutil.which("gsettings")
    if not gsettings:
        return "gsettings is not installed"

    result = run_process([gsettings, "set", schema, key, "true" if value else "false"], timeout=5)
    if result.returncode != 0:
        return (result.stderr or result.stdout).strip() or f"Could not write {schema} {key}"
    return None


def gsettings_get_int(schema: str, key: str) -> tuple[Optional[int], str]:
    gsettings = shutil.which("gsettings")
    if not gsettings:
        return None, "gsettings is not installed"

    result = run_process([gsettings, "get", schema, key], timeout=5)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip() or f"Could not read {schema} {key}"
        return None, detail

    value = result.stdout.strip()
    try:
        return int(value), ""
    except ValueError:
        return None, f"Unexpected gsettings value for {schema} {key}: {value}"


def gsettings_set_int(schema: str, key: str, value: int) -> Optional[str]:
    gsettings = shutil.which("gsettings")
    if not gsettings:
        return "gsettings is not installed"

    result = run_process([gsettings, "set", schema, key, str(value)], timeout=5)
    if result.returncode != 0:
        return (result.stderr or result.stdout).strip() or f"Could not write {schema} {key}"
    return None


def read_onboard_window_sizes() -> tuple[Dict[str, Dict[str, int]], List[str]]:
    sizes: Dict[str, Dict[str, int]] = {}
    errors: List[str] = []
    for schema, values in ONBOARD_TABLET_LARGE_SIZE.items():
        sizes[schema] = {}
        for key in values:
            current, error = gsettings_get_int(schema, key)
            if error:
                errors.append(error)
            elif current is not None:
                sizes[schema][key] = current
    return sizes, errors


def apply_onboard_window_sizes(sizes: Dict[str, object]) -> List[str]:
    errors: List[str] = []
    for schema, values in sizes.items():
        if not isinstance(values, dict):
            continue
        for key, value in values.items():
            if not isinstance(value, int):
                continue
            error = gsettings_set_int(str(schema), str(key), value)
            if error:
                errors.append(error)
    return errors


def process_running(name: str) -> bool:
    pgrep = shutil.which("pgrep")
    if not pgrep:
        return False
    return run_process([pgrep, "-x", name], timeout=5).returncode == 0


def onboard_keyboard_status() -> Dict[str, object]:
    auto_show, auto_show_error = gsettings_get_bool(ONBOARD_SCHEMA, ONBOARD_AUTO_SHOW_KEY)
    accessibility, accessibility_error = gsettings_get_bool(
        GNOME_INTERFACE_SCHEMA,
        TOOLKIT_ACCESSIBILITY_KEY,
    )
    window_sizes, size_errors = read_onboard_window_sizes()
    errors = [error for error in (auto_show_error, accessibility_error) if error]
    errors.extend(size_errors)
    return {
        "available": shutil.which("onboard") is not None,
        "running": process_running("onboard"),
        "auto_show": auto_show,
        "toolkit_accessibility": accessibility,
        "window_sizes": window_sizes,
        "restore_pending": ONBOARD_RESTORE_PATH.exists(),
        "error": "; ".join(errors),
    }


def onboard_keyboard_status_process() -> subprocess.CompletedProcess:
    return subprocess.CompletedProcess(
        ["onboard", "tablet-keyboard-status"],
        0,
        json.dumps(onboard_keyboard_status()),
        "",
    )


def read_onboard_restore_state() -> Dict[str, object]:
    if not ONBOARD_RESTORE_PATH.exists():
        return {}
    try:
        return json.loads(ONBOARD_RESTORE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def write_onboard_restore_state(state: Dict[str, object]) -> Optional[str]:
    try:
        ONBOARD_RESTORE_PATH.parent.mkdir(parents=True, exist_ok=True)
        ONBOARD_RESTORE_PATH.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    except OSError as exc:
        return f"Could not save Onboard restore state: {exc}"
    return None


def remove_onboard_restore_state() -> None:
    try:
        ONBOARD_RESTORE_PATH.unlink()
    except FileNotFoundError:
        pass
    except OSError:
        pass


def stop_onboard_process() -> Optional[str]:
    if not process_running("onboard"):
        return None

    pkill = shutil.which("pkill")
    if not pkill:
        return "pkill is not installed; Onboard was left running"

    result = run_process([pkill, "-x", "onboard"], timeout=5)
    if result.returncode not in {0, 1}:
        return (result.stderr or result.stdout).strip() or "Could not stop Onboard"
    return None


def enable_onboard_keyboard_process() -> subprocess.CompletedProcess:
    onboard = shutil.which("onboard")
    if not onboard:
        return subprocess.CompletedProcess([], 1, json.dumps(onboard_keyboard_status()), "Onboard is not installed")

    auto_show, auto_show_error = gsettings_get_bool(ONBOARD_SCHEMA, ONBOARD_AUTO_SHOW_KEY)
    accessibility, accessibility_error = gsettings_get_bool(
        GNOME_INTERFACE_SCHEMA,
        TOOLKIT_ACCESSIBILITY_KEY,
    )
    errors = [error for error in (auto_show_error, accessibility_error) if error]
    if errors:
        return subprocess.CompletedProcess([], 1, json.dumps(onboard_keyboard_status()), "\n".join(errors))

    window_sizes, size_errors = read_onboard_window_sizes()
    if size_errors:
        return subprocess.CompletedProcess([], 1, json.dumps(onboard_keyboard_status()), "\n".join(size_errors))

    previous_state = read_onboard_restore_state()
    if not previous_state:
        error = write_onboard_restore_state(
            {
                "auto_show_enabled": auto_show,
                "toolkit_accessibility": accessibility,
                "onboard_was_running": process_running("onboard"),
                "window_sizes": window_sizes,
            }
        )
        if error:
            return subprocess.CompletedProcess([], 1, json.dumps(onboard_keyboard_status()), error)
    elif "window_sizes" not in previous_state:
        previous_state["window_sizes"] = window_sizes
        error = write_onboard_restore_state(previous_state)
        if error:
            return subprocess.CompletedProcess([], 1, json.dumps(onboard_keyboard_status()), error)

    errors = []
    for schema, key in (
        (GNOME_INTERFACE_SCHEMA, TOOLKIT_ACCESSIBILITY_KEY),
        (ONBOARD_SCHEMA, ONBOARD_AUTO_SHOW_KEY),
    ):
        error = gsettings_set_bool(schema, key, True)
        if error:
            errors.append(error)
    errors.extend(apply_onboard_window_sizes(ONBOARD_TABLET_LARGE_SIZE))

    if errors:
        restore_onboard_keyboard_process(stop_started=False)
        return subprocess.CompletedProcess([], 1, json.dumps(onboard_keyboard_status()), "\n".join(errors))

    if not process_running("onboard"):
        try:
            subprocess.Popen(
                [onboard],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as exc:
            restore_onboard_keyboard_process(stop_started=False)
            return subprocess.CompletedProcess([], 1, json.dumps(onboard_keyboard_status()), f"Could not start Onboard: {exc}")

    return subprocess.CompletedProcess([onboard], 0, json.dumps(onboard_keyboard_status()), "")


def restore_onboard_keyboard_process(stop_started: bool = True) -> subprocess.CompletedProcess:
    state = read_onboard_restore_state()
    errors: List[str] = []

    if state:
        auto_show = state.get("auto_show_enabled")
        if isinstance(auto_show, bool):
            error = gsettings_set_bool(ONBOARD_SCHEMA, ONBOARD_AUTO_SHOW_KEY, auto_show)
            if error:
                errors.append(error)

        accessibility = state.get("toolkit_accessibility")
        if isinstance(accessibility, bool):
            error = gsettings_set_bool(GNOME_INTERFACE_SCHEMA, TOOLKIT_ACCESSIBILITY_KEY, accessibility)
            if error:
                errors.append(error)

        window_sizes = state.get("window_sizes")
        if isinstance(window_sizes, dict):
            errors.extend(apply_onboard_window_sizes(window_sizes))

        if stop_started and state.get("onboard_was_running") is False:
            error = stop_onboard_process()
            if error:
                errors.append(error)

        if not errors:
            remove_onboard_restore_state()

    return subprocess.CompletedProcess(
        ["onboard", "tablet-keyboard-restore"],
        1 if errors else 0,
        json.dumps(onboard_keyboard_status()),
        "\n".join(errors),
    )


def set_tablet_mode_process(lock: bool, keyboard_enabled: bool) -> subprocess.CompletedProcess:
    if lock and keyboard_enabled:
        keyboard_result = enable_onboard_keyboard_process()
        if keyboard_result.returncode != 0:
            return subprocess.CompletedProcess(
                [],
                1,
                json.dumps(tablet_lock_status()),
                "On-screen keyboard setup failed before locking input:\n"
                + (keyboard_result.stderr or keyboard_result.stdout).strip(),
            )

    lock_result = set_tablet_lock_process(lock)
    if lock_result.returncode != 0:
        if lock and keyboard_enabled:
            restore_onboard_keyboard_process(stop_started=True)
        return lock_result

    if not lock:
        keyboard_result = restore_onboard_keyboard_process(stop_started=True)
        if keyboard_result.returncode != 0:
            detail = (keyboard_result.stderr or keyboard_result.stdout).strip()
            return subprocess.CompletedProcess(lock_result.args, 1, lock_result.stdout, detail)

    return lock_result


def read_config() -> OrderedDict:
    config = OrderedDict(DEFAULT_CONFIG)
    extras = OrderedDict()

    if CONFIG_PATH.exists():
        for raw_line in CONFIG_PATH.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip()
            if key in config:
                config[key] = value
            else:
                extras[key] = value

    for key, value in extras.items():
        config[key] = value
    return config


def write_config(config: Dict[str, str]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines: List[str] = []
    for key, default_value in DEFAULT_CONFIG.items():
        lines.append(f"{key}={config.get(key, default_value)}")

    for key, value in config.items():
        if key not in DEFAULT_CONFIG:
            lines.append(f"{key}={value}")

    CONFIG_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


def read_state() -> Dict[str, str]:
    if not STATE_PATH.exists():
        return {}
    try:
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def sensor_age_text(updated_at: str) -> str:
    if not updated_at:
        return "no sensor event recorded"

    try:
        updated = datetime.fromisoformat(updated_at)
        now = datetime.now(updated.tzinfo) if updated.tzinfo else datetime.now()
        seconds = max(0, int((now - updated).total_seconds()))
    except ValueError:
        return f"last event: {updated_at}"

    if seconds < 5:
        return "last event just now"
    if seconds < 60:
        return f"last event {seconds}s ago"
    minutes = seconds // 60
    if minutes < 60:
        return f"last event {minutes}m ago"
    hours = minutes // 60
    return f"last event {hours}h ago"


class SensorDrawing(Gtk.DrawingArea):
    def __init__(self) -> None:
        super().__init__()
        self.orientation = "unknown"
        self.set_size_request(150, 112)
        self.connect("draw", self.on_draw)

    def set_orientation(self, orientation: str) -> None:
        self.orientation = orientation
        self.queue_draw()

    def on_draw(self, area: Gtk.DrawingArea, context) -> bool:
        allocation = area.get_allocation()
        width = allocation.width
        height = allocation.height
        center_x = width / 2
        center_y = height / 2

        context.set_source_rgb(0.94, 0.96, 0.98)
        rounded_rectangle(context, 8, 8, width - 16, height - 16, 10)
        context.fill()

        context.save()
        context.translate(center_x, center_y)
        context.rotate(math.radians(SENSOR_ANGLES.get(self.orientation, 0)))

        if self.orientation not in SENSOR_ANGLES:
            context.set_source_rgb(0.55, 0.60, 0.65)
        else:
            context.set_source_rgb(0.10, 0.42, 0.82)
        rounded_rectangle(context, -42, -34, 84, 56, 7)
        context.fill()

        context.set_source_rgb(0.84, 0.91, 0.98)
        rounded_rectangle(context, -34, -27, 68, 42, 4)
        context.fill()

        context.set_source_rgb(0.15, 0.21, 0.27)
        rounded_rectangle(context, -52, 23, 104, 20, 5)
        context.fill()

        context.set_source_rgb(0.70, 0.77, 0.83)
        rounded_rectangle(context, -31, 28, 62, 6, 3)
        context.fill()

        context.restore()

        if self.orientation not in SENSOR_ANGLES:
            context.set_source_rgb(0.38, 0.42, 0.46)
            context.set_font_size(24)
            context.move_to(center_x - 7, center_y + 9)
            context.show_text("?")

        return False


def rounded_rectangle(context, x: float, y: float, width: float, height: float, radius: float) -> None:
    context.new_sub_path()
    context.arc(x + width - radius, y + radius, radius, -math.pi / 2, 0)
    context.arc(x + width - radius, y + height - radius, radius, 0, math.pi / 2)
    context.arc(x + radius, y + height - radius, radius, math.pi / 2, math.pi)
    context.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
    context.close_path()


class ControlPanel(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID)
        self.window: Optional[Gtk.ApplicationWindow] = None
        self.status_labels: Dict[str, Gtk.Label] = {}
        self.status_values: Dict[str, str] = {}
        self.config = read_config()
        self.loading = False
        self.busy_count = 0
