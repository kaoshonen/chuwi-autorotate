        self.load_config_into_widgets()

        def work() -> subprocess.CompletedProcess:
            return run_command(["status"], timeout=15)

        def done(result: subprocess.CompletedProcess) -> None:
            if result.returncode == 0:
                self.status_values = parse_status(result.stdout)
                self.update_status_labels()
            else:
                detail = (result.stderr or result.stdout).strip()
                self.set_message(f"Could not refresh status: {detail}")

        self.run_background(work, done)
        self.refresh_tablet_lock_status()

    def load_config_into_widgets(self) -> None:
        self.loading = True
        try:
            self.touch_switch.set_active(bool_value(self.config.get("touch_enabled", "true")))
            offset = self.config.get("orientation_offset", "right")
            self.offset_combo.set_active(ROTATIONS.index(offset) if offset in ROTATIONS else 1)
            self.debounce_spin.set_value(float(self.config.get("debounce_seconds", "1.0")))
            self.startup_wait_spin.set_value(float(self.config.get("startup_wait_seconds", "90")))

            blacklist = {
                value
                for value in self.config.get("blacklist_rotations", "").replace(",", " ").split()
                if value in ROTATIONS
            }
            for rotation, check in self.blacklist_checks.items():
                check.set_active(rotation in blacklist)

            self.auto_switch.set_active(bool_value(self.config.get("enabled", "true")))
        except ValueError:
            pass
        finally:
            self.loading = False

    def update_status_labels(self) -> None:
        for key, label in self.status_labels.items():
            label.set_text(self.status_values.get(key, "unknown"))

        enabled = self.status_values.get("enabled", self.config.get("enabled", "false"))
        self.loading = True
        self.auto_switch.set_active(bool_value(enabled))
        self.loading = False
        self.greeter_label.set_text(self.status_values.get("LightDM greeter rotation", "unknown"))

    def refresh_tablet_lock_status(self) -> None:
        def work() -> subprocess.CompletedProcess:
            return tablet_lock_status_process()

        def done(result: subprocess.CompletedProcess) -> None:
            self.apply_tablet_lock_status_result(result)

        self.run_background(work, done, busy=False)

    def apply_tablet_lock_status_result(self, result: subprocess.CompletedProcess) -> None:
        try:
            status = json.loads(result.stdout or "{}")
        except json.JSONDecodeError:
            status = {
                "available": False,
                "error": "Could not read tablet input lock status",
                "devices": [],
                "missing": list(TABLET_LOCK_DEVICE_NAMES),
                "locked": False,
                "partial": False,
            }
        self.apply_tablet_lock_status(status)

    def apply_tablet_lock_status(self, status: Dict[str, object]) -> None:
        devices = status.get("devices", [])
        missing = status.get("missing", [])
        available = bool(status.get("available"))
        locked = bool(status.get("locked"))
        partial = bool(status.get("partial"))
        self.tablet_lock_active = locked
        self.tablet_lock_partial = partial

        if not available:
            error = str(status.get("error", "xinput is unavailable"))
            status_text = f"Tablet input lock unavailable: {error}"
        elif locked:
            status_text = "Tablet input lock is ON for this session. Touchscreen and power button remain active."
        elif partial:
            status_text = "Tablet input lock is partially active. Use Unlock to return all matched devices to normal."
        else:
            status_text = "Tablet input lock is OFF. Restarting or logging in starts with normal input."

        device_parts: List[str] = []
        for device in (devices if isinstance(devices, list) else []):
            if not isinstance(device, dict):
                continue
            enabled = device.get("enabled")
            state = "enabled" if enabled is True else "disabled" if enabled is False else "unknown"
            device_parts.append(f"{device.get('name', 'unknown')} ({state})")
        if missing:
            device_parts.append("missing: " + ", ".join(str(name) for name in missing))

        self.tablet_lock_status_label.set_text(status_text)
        self.tablet_lock_devices_label.set_text(
            "Targets: " + "; ".join(device_parts) if device_parts else "Targets: internal keyboard and pointer"
        )

        should_unlock = locked or partial
        self.tablet_lock_button.set_label(
            "Unlock Keyboard and Pointer" if should_unlock else "Enable Tablet Input Lock"
        )
        self.tablet_lock_button.set_sensitive(available and (bool(devices) or should_unlock))

    def on_tablet_lock_button(self, _button: Gtk.Button) -> None:
        lock = not (self.tablet_lock_active or self.tablet_lock_partial)

        def work() -> subprocess.CompletedProcess:
            return set_tablet_lock_process(lock)

        def done(result: subprocess.CompletedProcess) -> None:
            self.apply_tablet_lock_status_result(result)
            if result.returncode == 0:
                if lock:
                    self.set_message("Tablet input lock enabled for this session only.")
                else:
                    self.set_message("Keyboard and pointer unlocked.")
            else:
                detail = (result.stderr or result.stdout).strip()
                self.set_message(f"Tablet input lock failed.\n{detail}")

        self.run_background(work, done)

    def update_sensor_indicator(self) -> bool:
        self.sensor_state = read_state()
        orientation = self.sensor_state.get("last_sensor_orientation", "unknown")
        updated_at = self.sensor_state.get("updated_at", "")
        self.sensor_drawing.set_orientation(orientation)
        self.sensor_orientation_label.set_text(f"sensor: {orientation}")
        self.sensor_age_label.set_text(sensor_age_text(updated_at))
        if "last known sensor orientation" in self.status_labels:
            self.status_labels["last known sensor orientation"].set_text(orientation)
        return True

    def on_auto_switch(self, _switch: Gtk.Switch, state: bool) -> bool:
        if self.loading:
            return False
        command = ["on"] if state else ["off"]
        message = "Auto-rotation enabled." if state else "Auto-rotation disabled and reset to HOME."
        self.run_action(command, message, refresh_config=True)
        return False

    def save_settings(self, _button: Gtk.Button) -> None:
        config = read_config()
        config["touch_enabled"] = "true" if self.touch_switch.get_active() else "false"
        active_offset = self.offset_combo.get_active_text()
        config["orientation_offset"] = active_offset or config.get("orientation_offset", "right")
        config["debounce_seconds"] = f"{self.debounce_spin.get_value():.1f}"
        config["startup_wait_seconds"] = str(int(self.startup_wait_spin.get_value()))
        blacklist = [
            rotation for rotation, check in self.blacklist_checks.items() if check.get_active()
        ]
        config["blacklist_rotations"] = " ".join(blacklist)
        write_config(config)
        self.config = config
        self.set_message("Settings saved.")
        self.refresh()

    def run_action(
        self,
        args: List[str],
        success_message: str,
        refresh_config: bool = False,
        use_pkexec: bool = False,
    ) -> None:
        def work() -> subprocess.CompletedProcess:
            return run_command(args, timeout=45, use_pkexec=use_pkexec)

        def done(result: subprocess.CompletedProcess) -> None:
            if refresh_config:
                self.config = read_config()
            if result.returncode == 0:
                detail = result.stdout.strip()
                self.set_message(success_message if not detail else f"{success_message}\n{detail}")
            else:
                detail = (result.stderr or result.stdout).strip()
                self.set_message(f"Command failed: {' '.join(args)}\n{detail}")
            self.refresh()

        self.run_background(work, done)

    def run_doctor(self, _button: Gtk.Button) -> None:
        def work() -> subprocess.CompletedProcess:
            return run_command(["doctor"], timeout=20)

        def done(result: subprocess.CompletedProcess) -> None:
            dialog = Gtk.MessageDialog(
                transient_for=self.window,
                modal=True,
                message_type=Gtk.MessageType.INFO if result.returncode == 0 else Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.CLOSE,
                text="Doctor",
            )
            dialog.format_secondary_text((result.stdout or result.stderr).strip())
            dialog.run()
            dialog.destroy()
            self.refresh()

        self.run_background(work, done)

    def install_greeter(self, _button: Gtk.Button) -> None:
        display = self.config.get("display", "auto")
        rotation = self.config.get("home_rotation", "auto")
        if rotation not in ROTATIONS:
            self.set_message("Calibrate HOME before installing login/lock screen rotation.")
            return
        args = ["greeter-install", "--display", display, "--rotation", rotation]
        self.run_action(args, "Login/lock screen rotation installed.", use_pkexec=True)

    def remove_greeter(self, _button: Gtk.Button) -> None:
        self.run_action(["greeter-uninstall"], "Login/lock screen rotation removed.", use_pkexec=True)

    def show_about(self, _button: Gtk.Button) -> None:
        dialog = Gtk.AboutDialog(transient_for=self.window, modal=True)
        dialog.set_program_name(APP_NAME)
        dialog.set_version(APP_VERSION)
        dialog.set_comments("Control panel for CHUWI MiniBook automatic screen rotation.")
        dialog.set_copyright("Made by Kyle Auchterlonie 2026")
        dialog.set_website(REPOSITORY_URL)
        dialog.set_website_label(REPOSITORY_URL)
        dialog.set_authors(["Kyle Auchterlonie"])
        dialog.set_logo_icon_name("chuwi-autorotate-panel")
        dialog.run()
        dialog.destroy()

    def run_background(
        self,
        work: Callable[[], subprocess.CompletedProcess],
        done: Callable[[subprocess.CompletedProcess], None],
        busy: bool = True,
    ) -> None:
        if busy:
            self.set_busy(True)

        def target() -> None:
            try:
                result = work()
            except Exception as exc:  # noqa: BLE001 - report unexpected GUI action failures.
                result = subprocess.CompletedProcess([], 1, "", str(exc))
            GLib.idle_add(self.finish_background, done, result, busy)

        threading.Thread(target=target, daemon=True).start()

    def finish_background(
        self,
        done: Callable[[subprocess.CompletedProcess], None],
        result: subprocess.CompletedProcess,
        busy: bool,
    ) -> bool:
        try:
            done(result)
        finally:
            if busy:
                self.set_busy(False)
        return False


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog="chuwi-autorotate-panel")
    parser.add_argument("--version", action="store_true", help="Print version and exit")
    args, remaining = parser.parse_known_args(argv)
    if args.version:
        print(f"{APP_NAME} {APP_VERSION}")
        return 0

    app = ControlPanel()
    return app.run([sys.argv[0], *remaining])


if __name__ == "__main__":
    sys.exit(main())
