        super().__init__(application_id=APP_ID)
        self.window: Optional[Gtk.ApplicationWindow] = None
        self.status_labels: Dict[str, Gtk.Label] = {}
        self.status_values: Dict[str, str] = {}
        self.config = read_config()
        self.loading = False
        self.busy_count = 0
        self.sensor_state: Dict[str, str] = {}
        self.sensor_timer_id: Optional[int] = None
        self.tablet_lock_active = False
        self.tablet_lock_partial = False

    def do_activate(self) -> None:
        if self.window is None:
            self.window = self.build_window()
            self.window.show_all()
        self.window.present()
        self.refresh()
        if self.sensor_timer_id is None:
            self.sensor_timer_id = GLib.timeout_add_seconds(1, self.update_sensor_indicator)
        self.update_sensor_indicator()

    def do_shutdown(self) -> None:
        if self.sensor_timer_id is not None:
            GLib.source_remove(self.sensor_timer_id)
            self.sensor_timer_id = None
        Gtk.Application.do_shutdown(self)

